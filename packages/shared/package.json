{
  "name": "@manyhands/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node-cli-process": {
      "types": "./dist/node-cli-process.d.ts",
      "import": "./dist/node-cli-process.js",
      "require": "./dist/node-cli-process.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/node-cli-process.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
