{
  "name": "@manyhands/execution-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@manyhands/shared": "workspace:*",
    "@manyhands/task-graph": "workspace:*",
    "@manyhands/contracts": "workspace:*",
    "@manyhands/trace-store": "workspace:*",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  }
}
