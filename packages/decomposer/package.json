{
  "name": "@manyhands/decomposer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mocks": {
      "types": "./dist/mocks/mock-decomposer.d.ts",
      "import": "./dist/mocks/mock-decomposer.js",
      "require": "./dist/mocks/mock-decomposer.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/mocks/mock-decomposer.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@manyhands/contracts": "workspace:*",
    "@manyhands/shared": "workspace:*",
    "@manyhands/task-graph": "workspace:*",
    "zod": "^3.23.8"
  }
}
