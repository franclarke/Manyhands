{
  "name": "@manyhands/orchestrator-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint": "^1.0.4",
    "@manyhands/contracts": "workspace:*",
    "@manyhands/conflict-risk": "workspace:*",
    "@manyhands/decomposer": "workspace:*",
    "@manyhands/execution-core": "workspace:*",
    "@manyhands/repository-index": "workspace:*",
    "@manyhands/scheduler": "workspace:*",
    "@manyhands/task-graph": "workspace:*",
    "@manyhands/trace-store": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
