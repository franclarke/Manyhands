{
  "name": "manyhands",
  "version": "0.1.0",
  "private": true,
  "description": "ManyHands monorepo: LLM agent orchestration for software development.",
  "packageManager": "pnpm@7.29.3",
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "web:dev": "pnpm build:packages && pnpm --filter @manyhands/web dev",
    "web:build": "pnpm build:packages && pnpm --filter @manyhands/web build",
    "web:typecheck": "pnpm build:packages && pnpm --filter @manyhands/web typecheck",
    "web:lint": "pnpm --filter @manyhands/web lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern apps/web/** --max-warnings=0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "ts-morph": "^28.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "patchedDependencies": {
      "@assistant-ui/tap@0.6.0": "patches/@assistant-ui__tap@0.6.0.patch"
    }
  }
}
