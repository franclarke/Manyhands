    "id": "goal:express-request-correlation",
    "revision": 1,
    "goal": "Add opt-in request correlation IDs to Express so an incoming X-Request-Id is preserved or a secure ID is generated, req.id is available to handlers, the response header is emitted, and default behavior remains unchanged.",
