        ]
      },
      "outcomes": [
        {
          "id": "outcome:root-request-id",
          "statement": "The planned integration preserves or securely generates one request ID, exposes it as req.id, and emits the same X-Request-Id value when enabled."
        },
        {
          "id": "outcome:root-opt-in",
          "statement": "The planned integration leaves default request and response behavior unchanged when correlation IDs are not enabled."
        },
        {
          "id": "outcome:root-documented",
          "statement": "The planned public surface is covered by focused tests and documentation."
        }
      ],
      "criteria": [
        {
          "criterionId": "criterion-ref:root-request-id",
          "statement": "When enabled, each request exposes req.id and returns the same X-Request-Id, preserving a valid incoming value or generating one.",
          "sourceCriterionId": "criterion:request-id"
        },
        {
          "criterionId": "criterion-ref:root-opt-in",
          "statement": "Existing applications that do not enable correlation IDs retain current request and response behavior.",
          "sourceCriterionId": "criterion:opt-in"
        },
        {
          "criterionId": "criterion-ref:root-documented",
