    "unit:request-correlation": {
      "id": "unit:request-correlation",
      "role": "composite",
      "title": "Integrate opt-in request correlation",
      "objective": "Integrate opt-in configuration, request identity, response propagation, focused tests, and public documentation without claiming implementation or runtime success.",
      "boundary": {
        "kind": "application",
        "evidenceRefs": [
          "evidence:2599eac21baefa30524e840c",
