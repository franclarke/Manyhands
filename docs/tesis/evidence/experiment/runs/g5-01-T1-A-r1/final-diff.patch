   name: string;
 }
 
+export const expenseCategories = ["food", "transport", "lodging", "entertainment", "other"] as const;
+
+export type ExpenseCategory = (typeof expenseCategories)[number];
+
 export interface Expense {
   id: string;
   description: string;
   amountCents: number;
   paidByParticipantId: string;
   sharedWithParticipantIds: string[];
+  category?: ExpenseCategory;
 }
 
 export interface Balance {
@@ -17,9 +22,19 @@ export interface Balance {
   netCents: number;
 }
 
+export interface CategoryTotal {
+  category: ExpenseCategory;
+  totalCents: number;
+}
+
+function isExpenseCategory(value: unknown): value is ExpenseCategory {
+  return typeof value === "string" && (expenseCategories as readonly string[]).includes(value);
+}
+
 export function createExpense(input: Expense): Expense {
   if (input.amountCents <= 0) throw new Error("An expense amount must be positive.");
   if (input.sharedWithParticipantIds.length === 0) throw new Error("An expense must be shared with at least one participant.");
+  if (input.category !== undefined && !isExpenseCategory(input.category)) throw new Error(`Invalid expense category: ${input.category}.`);
   return { ...input, sharedWithParticipantIds: [...new Set(input.sharedWithParticipantIds)] };
 }
 
@@ -35,3 +50,15 @@ export function computeBalances(participants: readonly Participant[], expenses:
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+export function computeCategoryTotals(expenses: readonly Expense[]): CategoryTotal[] {
+  const totals = new Map<ExpenseCategory, number>();
+  for (const expense of expenses) {
+    if (expense.category === undefined) continue;
+    totals.set(expense.category, (totals.get(expense.category) ?? 0) + expense.amountCents);
+  }
+
+  return expenseCategories
+    .filter((category) => totals.has(category))
+    .map((category) => ({ category, totalCents: totals.get(category) ?? 0 }));
+}
