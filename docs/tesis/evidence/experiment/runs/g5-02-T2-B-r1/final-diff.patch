 /** Splits each expense evenly across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
+  const supportedParticipantIds = new Set(participants.map((participant) => participant.id));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
-    for (const participantId of expense.sharedWithParticipantIds) {
-      net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+    if (expense.participantWeights !== undefined) {
+      const sharedWithParticipantIds = [...new Set(expense.sharedWithParticipantIds)];
+      validateParticipantWeights(sharedWithParticipantIds, expense.participantWeights, supportedParticipantIds);
+      for (const participantId of sharedWithParticipantIds) {
+        const shareCents = Math.round(expense.amountCents * expense.participantWeights[participantId]);
+        net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+      }
+    } else {
+      const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+      for (const participantId of expense.sharedWithParticipantIds) {
+        net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+      }
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function validateParticipantWeights(
+  sharedWithParticipantIds: readonly string[],
+  participantWeights: Readonly<Record<string, number>>,
+  supportedParticipantIds?: ReadonlySet<string>
+): void {
+  const sharedWith = new Set(sharedWithParticipantIds);
+  const weightedParticipantIds = Object.keys(participantWeights);
+
+  for (const participantId of weightedParticipantIds) {
+    if (!sharedWith.has(participantId) || (supportedParticipantIds !== undefined && !supportedParticipantIds.has(participantId))) {
+      throw new Error(`Unsupported participant weight: ${participantId}.`);
+    }
+  }
+
+  for (const participantId of sharedWithParticipantIds) {
+    if (!Object.hasOwn(participantWeights, participantId)) {
+      throw new Error("Weighted expenses require one weight per participant.");
+    }
+
+    const weight = participantWeights[participantId];
+    if (!Number.isFinite(weight) || weight <= 0) {
+      throw new Error("Participant weights must be positive numbers.");
+    }
+  }
+
+  if (weightedParticipantIds.length !== sharedWithParticipantIds.length) {
+    throw new Error("Weighted expenses require one weight per participant.");
+  }
+
+  const totalWeight = sharedWithParticipantIds.reduce((sum, participantId) => sum + participantWeights[participantId], 0);
+  if (totalWeight !== 1) {
+    throw new Error("Participant weights must sum exactly to 1.");
+  }
+}
