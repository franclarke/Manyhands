-/** Splits each expense evenly across its participants and nets the result. */
+function validateWeights(sharedWithParticipantIds: readonly string[], weights: Record<string, number> | undefined): void {
+  if (!weights) return;
+
+  const participantIds = new Set(sharedWithParticipantIds);
+  const weightedParticipantIds = Object.keys(weights);
+  const coversEveryParticipant =
+    weightedParticipantIds.length === participantIds.size &&
+    weightedParticipantIds.every((participantId) => participantIds.has(participantId));
+  if (!coversEveryParticipant) throw new Error("Expense weights must cover every participant exactly once.");
+
+  for (const weight of Object.values(weights)) {
+    if (!Number.isFinite(weight) || weight <= 0) throw new Error("Expense weights must be positive.");
+  }
+
+  const totalWeight = Object.values(weights).reduce((sum, weight) => sum + weight, 0);
+  if (totalWeight !== 1) throw new Error("Expense weights must sum to 1.");
+}
+
+function owedShareCents(expense: Expense, participantId: string): number {
+  const weight = expense.weightByParticipantId?.[participantId];
+  if (weight !== undefined) return Math.round(expense.amountCents * weight);
+  return Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+}
+
+/** Splits each expense across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
     for (const participantId of expense.sharedWithParticipantIds) {
-      net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+      net.set(participantId, (net.get(participantId) ?? 0) - owedShareCents(expense, participantId));
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
