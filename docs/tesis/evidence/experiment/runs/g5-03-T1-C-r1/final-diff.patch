+++ b/tests/summary-category-breakdown.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import { addExpense, createStore, listBalances, listCategoryTotals } from "../src/api/expenses.js";
+import { renderBalanceSummary, renderCategoryBreakdown } from "../src/web/summary.js";
+
+const participants = [
+  { id: "ana", name: "Ana" },
+  { id: "bruno", name: "Bruno" }
+];
+
+describe("summary category breakdown", () => {
+  it("renders category totals while keeping the balance summary available", () => {
+    let store = createStore(participants);
+    store = addExpense(store, {
+      id: "e1",
+      description: "Dinner",
+      amountCents: 4000,
+      paidByParticipantId: "ana",
+      sharedWithParticipantIds: ["ana", "bruno"],
+      category: "food"
+    } as Parameters<typeof addExpense>[1]);
+    store = addExpense(store, {
+      id: "e2",
+      description: "Taxi",
+      amountCents: 1200,
+      paidByParticipantId: "bruno",
+      sharedWithParticipantIds: ["ana", "bruno"],
+      category: "transportation"
+    } as Parameters<typeof addExpense>[1]);
+    store = addExpense(store, {
+      id: "e3",
+      description: "Uncategorized",
+      amountCents: 800,
+      paidByParticipantId: "ana",
+      sharedWithParticipantIds: ["ana", "bruno"]
+    });
+
+    const balances = listBalances(store);
+    const categoryTotals = listCategoryTotals(store);
+
+    expect(renderCategoryBreakdown(categoryTotals)).toBe("Food: $40.00\nTransportation: $12.00");
+    expect(renderBalanceSummary(participants, balances)).toBe("Ana: is owed $18.00\nBruno: owes $18.00");
+    expect(renderBalanceSummary(participants, balances, categoryTotals)).toBe(
+      "Ana: is owed $18.00\nBruno: owes $18.00\n\nCategory breakdown\nFood: $40.00\nTransportation: $12.00"
+    );
+  });
+});
