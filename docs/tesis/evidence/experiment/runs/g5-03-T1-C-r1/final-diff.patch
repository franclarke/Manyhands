+export interface CategoryTotal {
+  category: ExpenseCategory;
+  totalCents: number;
+}
+
+function assertExpenseCategory(category: unknown): asserts category is ExpenseCategory {
+  if (typeof category !== "string" || !expenseCategorySet.has(category)) {
+    throw new Error(`Unknown expense category: ${String(category)}.`);
+  }
+}
+
 export function createExpense(input: Expense): Expense {
   if (input.amountCents <= 0) throw new Error("An expense amount must be positive.");
   if (input.sharedWithParticipantIds.length === 0) throw new Error("An expense must be shared with at least one participant.");
+  if (input.category !== undefined) assertExpenseCategory(input.category);
   return { ...input, sharedWithParticipantIds: [...new Set(input.sharedWithParticipantIds)] };
 }
 
