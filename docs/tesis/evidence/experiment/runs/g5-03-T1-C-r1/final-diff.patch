+++ b/tests/api-category-totals.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from "vitest";
+import { addExpense, createStore, listCategoryTotals } from "../src/api/expenses.js";
+import { computeCategoryTotals } from "../src/domain/expense.js";
+
+const participants = [
+  { id: "ana", name: "Ana" },
+  { id: "bruno", name: "Bruno" }
+];
+
+describe("domain category totals", () => {
+  it("aggregates categorized expenses and skips uncategorized expenses", () => {
+    const totals = computeCategoryTotals([
+      { id: "e1", description: "Dinner", amountCents: 4200, paidByParticipantId: "ana", sharedWithParticipantIds: ["ana", "bruno"], category: "food" },
+      { id: "e2", description: "Taxi", amountCents: 1800, paidByParticipantId: "bruno", sharedWithParticipantIds: ["ana", "bruno"], category: "transport" },
+      { id: "e3", description: "Snacks", amountCents: 900, paidByParticipantId: "ana", sharedWithParticipantIds: ["ana", "bruno"], category: "food" },
+      { id: "e4", description: "Shared note", amountCents: 100, paidByParticipantId: "ana", sharedWithParticipantIds: ["ana", "bruno"] }
+    ]);
+
+    expect(totals).toEqual([
+      { category: "food", totalCents: 5100 },
+      { category: "transport", totalCents: 1800 }
+    ]);
+  });
+});
+
+describe("expense api category totals", () => {
+  it("lists category totals for the stored expenses", () => {
+    let store = createStore(participants);
+    store = addExpense(store, { id: "e1", description: "Dinner", amountCents: 4200, paidByParticipantId: "ana", sharedWithParticipantIds: ["ana", "bruno"], category: "food" });
+    store = addExpense(store, { id: "e2", description: "Taxi", amountCents: 1800, paidByParticipantId: "bruno", sharedWithParticipantIds: ["ana", "bruno"], category: "transport" });
+    store = addExpense(store, { id: "e3", description: "Snacks", amountCents: 900, paidByParticipantId: "ana", sharedWithParticipantIds: ["ana", "bruno"], category: "food" });
+
+    expect(listCategoryTotals(store)).toEqual([
+      { category: "food", totalCents: 5100 },
+      { category: "transport", totalCents: 1800 }
+    ]);
+  });
+});
