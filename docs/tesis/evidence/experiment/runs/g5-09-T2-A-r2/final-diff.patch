-/** Splits each expense evenly across its participants and nets the result. */
+/** Splits each expense across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
-    for (const participantId of expense.sharedWithParticipantIds) {
+    const shares = computeSharesCents(expense);
+    for (const [participantId, shareCents] of shares) {
       net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function computeSharesCents(expense: Expense): ParticipantShare[] {
+  if (expense.participantWeights === undefined) {
+    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+    return expense.sharedWithParticipantIds.map((participantId) => [participantId, shareCents]);
+  }
+
+  validateParticipantWeights(expense);
+  const shares = computeWeightedSharesCents(expense);
+  validateSharesBalance(expense.amountCents, shares);
+  return [...shares.entries()];
+}
+
+function validateParticipantWeights(expense: Expense): void {
+  const participantWeights = expense.participantWeights;
+  if (participantWeights === undefined) return;
+
+  const sharedParticipantIds = new Set(expense.sharedWithParticipantIds);
+  const weightedParticipantIds = Object.keys(participantWeights);
+  if (weightedParticipantIds.length !== sharedParticipantIds.size || weightedParticipantIds.some((participantId) => !sharedParticipantIds.has(participantId))) {
+    throw new Error("Participant weights must match the expense participants.");
+  }
+
+  for (const participantId of expense.sharedWithParticipantIds) {
+    const weight = participantWeights[participantId];
+    if (typeof weight !== "number" || !Number.isFinite(weight) || weight <= 0) {
+      throw new Error("Participant weights must be positive.");
+    }
+  }
+}
+
+function validateWeightedSharesBalance(expense: Expense): void {
+  validateSharesBalance(expense.amountCents, computeWeightedSharesCents(expense));
+}
+
+function computeWeightedSharesCents(expense: Expense): Map<string, number> {
+  const participantWeights = expense.participantWeights;
+  if (participantWeights === undefined) throw new Error("Participant weights are required for weighted shares.");
+
+  const totalWeight = expense.sharedWithParticipantIds.reduce((sum, participantId) => sum + participantWeights[participantId], 0);
+  const shares = new Map<string, number>();
+
+  for (const participantId of expense.sharedWithParticipantIds) {
+    const shareCents = (expense.amountCents * participantWeights[participantId]) / totalWeight;
+    if (!isWholeCent(shareCents)) {
+      throw new Error("Weighted participant shares must balance with the expense total.");
+    }
+    shares.set(participantId, Math.round(shareCents));
+  }
+
+  return shares;
+}
+
+function validateSharesBalance(amountCents: number, shares: ReadonlyMap<string, number>): void {
+  const totalSharesCents = [...shares.values()].reduce((sum, shareCents) => sum + shareCents, 0);
+  if (totalSharesCents !== amountCents) {
+    throw new Error("Weighted participant shares must balance with the expense total.");
+  }
+}
+
+function isWholeCent(value: number): boolean {
+  return Math.abs(value - Math.round(value)) < 0.0000001;
+}
