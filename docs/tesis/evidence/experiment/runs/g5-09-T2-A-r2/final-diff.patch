-/** Splits each expense evenly across its participants and nets the result. */
+/** Splits each expense across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
     for (const participantId of expense.sharedWithParticipantIds) {
+      const shareCents = Math.round(expense.amountCents * getParticipantWeight(expense, participantId));
       net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function validateParticipantWeights(participantIds: readonly string[], weights: Record<string, number> | undefined): void {
+  if (!weights) return;
+
+  const weightedParticipantIds = Object.keys(weights);
+  if (weightedParticipantIds.length !== participantIds.length) {
+    throw new Error("Participant weights must include exactly one weight per shared participant.");
+  }
+
+  const sharedParticipantIds = new Set(participantIds);
+  for (const participantId of weightedParticipantIds) {
+    if (!sharedParticipantIds.has(participantId)) {
+      throw new Error("Participant weights must include exactly one weight per shared participant.");
+    }
+    const weight = weights[participantId];
+    if (typeof weight !== "number" || !Number.isFinite(weight) || weight <= 0) {
+      throw new Error("Participant weights must be positive numbers.");
+    }
+  }
+
+  const totalWeight = weightedParticipantIds.reduce((sum, participantId) => sum + weights[participantId], 0);
+  if (totalWeight !== 1) {
+    throw new Error("Participant weights must sum exactly to 1.");
+  }
+}
+
+function getParticipantWeight(expense: Expense, participantId: string): number {
+  return expense.participantWeights?.[participantId] ?? 1 / expense.sharedWithParticipantIds.length;
+}
