-/** Splits each expense evenly across its participants and nets the result. */
+/** Splits each expense across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
-    for (const participantId of expense.sharedWithParticipantIds) {
-      net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+    if (expense.weights === undefined) {
+      const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+      for (const participantId of expense.sharedWithParticipantIds) {
+        net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
+      }
+    } else {
+      const sharedWithParticipantIds = [...new Set(expense.sharedWithParticipantIds)];
+      validateWeights(expense.weights, sharedWithParticipantIds);
+      for (const participantId of sharedWithParticipantIds) {
+        net.set(participantId, (net.get(participantId) ?? 0) - expense.amountCents * expense.weights[participantId]);
+      }
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function validateWeights(weights: Record<string, number>, sharedWithParticipantIds: readonly string[]): void {
+  const participantIds = new Set(sharedWithParticipantIds);
+  for (const participantId of Object.keys(weights)) {
+    if (!participantIds.has(participantId)) throw new Error(`Weight includes participant outside the expense: ${participantId}.`);
+  }
+
+  for (const participantId of sharedWithParticipantIds) {
+    if (!Object.prototype.hasOwnProperty.call(weights, participantId)) throw new Error(`Weight is required for every participant in the expense: ${participantId}.`);
+    const weight = weights[participantId];
+    if (!Number.isFinite(weight) || weight <= 0) throw new Error(`Each participant weight must be positive: ${participantId}.`);
+  }
+
+  const totalWeight = sharedWithParticipantIds.reduce((total, participantId) => total + weights[participantId], 0);
+  if (totalWeight !== 1) throw new Error("Participant weights must sum exactly to 1.");
+}
