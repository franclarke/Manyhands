-/** Splits each expense evenly across its participants and nets the result. */
+/** Splits each expense across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
-    for (const participantId of expense.sharedWithParticipantIds) {
+    for (const { participantId, shareCents } of getParticipantShares(expense)) {
       net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function getParticipantShares(expense: Expense): { participantId: string; shareCents: number }[] {
+  if (!expense.participantWeights) {
+    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+    return expense.sharedWithParticipantIds.map((participantId) => ({ participantId, shareCents }));
+  }
+
+  const weights = expense.participantWeights;
+  let totalWeight = 0;
+  for (const participantId of expense.sharedWithParticipantIds) {
+    const weight = weights[participantId];
+    if (weight === undefined || weight <= 0 || !Number.isFinite(weight)) {
+      throw new Error(`Participant ${participantId} must have a positive weight for weighted expenses.`);
+    }
+    totalWeight += weight;
+  }
+
+  const shares = expense.sharedWithParticipantIds.map((participantId) => ({
+    participantId,
+    shareCents: Math.round((expense.amountCents * weights[participantId]) / totalWeight)
+  }));
+  const totalShares = shares.reduce((sum, share) => sum + share.shareCents, 0);
+  if (totalShares !== expense.amountCents) {
+    throw new Error("Weighted expense shares must balance to the expense total.");
+  }
+
+  return shares;
+}
