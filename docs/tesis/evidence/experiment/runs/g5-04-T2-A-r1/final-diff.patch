-/** Splits each expense evenly across its participants and nets the result. */
+/** Splits each expense evenly or by explicit weights across its participants and nets the result. */
 export function computeBalances(participants: readonly Participant[], expenses: readonly Expense[]): Balance[] {
   const net = new Map<string, number>(participants.map((participant) => [participant.id, 0]));
   for (const expense of expenses) {
-    const shareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
+    const equalShareCents = Math.round(expense.amountCents / expense.sharedWithParticipantIds.length);
     for (const participantId of expense.sharedWithParticipantIds) {
+      const shareCents = expense.participantWeights === undefined ? equalShareCents : Math.round(expense.amountCents * expense.participantWeights[participantId]);
       net.set(participantId, (net.get(participantId) ?? 0) - shareCents);
     }
     net.set(expense.paidByParticipantId, (net.get(expense.paidByParticipantId) ?? 0) + expense.amountCents);
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+function validateParticipantWeights(participantIds: readonly string[], weights: ParticipantWeights): ParticipantWeights {
+  const participantIdSet = new Set(participantIds);
+  const weightParticipantIds = Object.keys(weights);
+  const coversExactlySharedParticipants =
+    weightParticipantIds.length === participantIdSet.size && weightParticipantIds.every((participantId) => participantIdSet.has(participantId));
+  if (!coversExactlySharedParticipants) throw new Error("Expense weights must cover every participant exactly once.");
+
+  const validatedWeights: ParticipantWeights = {};
+  let total = 0;
+  for (const participantId of participantIds) {
+    const weight = weights[participantId];
+    if (!Number.isFinite(weight) || weight <= 0) throw new Error("Expense weights must be positive.");
+    validatedWeights[participantId] = weight;
+    total += weight;
+  }
+
+  if (total !== 1) throw new Error("Expense weights must sum to 1.");
+  return validatedWeights;
+}
