diff --git a/test/domain-orders.test.mjs b/test/domain-orders.test.mjs
new file mode 100644
index 0000000..9dc6580
--- /dev/null
+++ b/test/domain-orders.test.mjs
@@ -0,0 +1,60 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { cancelOrder, createWarehouse, placeOrder } from "../src/domain/orders.mjs";
+
+test("defaults priority to standard and accepts express", () => {
+  const standardState = placeOrder(createWarehouse({ sku: 5 }), { orderId: "o-1", skuId: "sku", quantity: 2 });
+  assert.equal(standardState.orders[0].priority, "standard");
+  assert.equal(standardState.orders[0].status, "reserved");
+  assert.equal(standardState.stockBySku.sku, 3);
+
+  const expressState = placeOrder(createWarehouse({ sku: 5 }), {
+    orderId: "o-2",
+    skuId: "sku",
+    quantity: 2,
+    priority: "express"
+  });
+  assert.equal(expressState.orders[0].priority, "express");
+});
+
+test("rejects invalid priority values with a priority error", () => {
+  assert.throws(
+    () => placeOrder(createWarehouse({ sku: 5 }), {
+      orderId: "o-3",
+      skuId: "sku",
+      quantity: 1,
+      priority: "overnight"
+    }),
+    /priority/
+  );
+});
+
+test("records a cancellable backorder with exact missing data when stock is insufficient", () => {
+  const placed = placeOrder(createWarehouse({ sku: 2 }), {
+    orderId: "o-4",
+    skuId: "sku",
+    quantity: 5
+  });
+
+  assert.equal(placed.orders.length, 1);
+  assert.deepEqual(placed.orders[0], {
+    orderId: "o-4",
+    skuId: "sku",
+    quantity: 5,
+    priority: "standard",
+    status: "backordered"
+  });
+  assert.deepEqual(placed.backorders, [
+    {
+      orderId: "o-4",
+      skuId: "sku",
+      missing: 3
+    }
+  ]);
+  assert.equal(placed.stockBySku.sku, 2);
+
+  const cancelled = cancelOrder(placed, "o-4");
+  assert.equal(cancelled.orders[0].status, "cancelled");
+  assert.equal(cancelled.stockBySku.sku, 2);
+  assert.deepEqual(cancelled.backorders, placed.backorders);
+});
diff --git a/test/order-service.test.mjs b/test/order-service.test.mjs
new file mode 100644
index 0000000..d6f2f18
--- /dev/null
+++ b/test/order-service.test.mjs
@@ -0,0 +1,58 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createWarehouse } from "../src/domain/orders.mjs";
+import { createOrderService } from "../src/application/order-service.mjs";
+
+test("preserves reserved-order behavior", () => {
+  const service = createOrderService(createWarehouse({ sku: 3 }));
+
+  service.place({ orderId: "o-1", skuId: "sku", quantity: 2 });
+
+  assert.deepEqual(service.currentOrders(), [
+    {
+      orderId: "o-1",
+      skuId: "sku",
+      quantity: 2,
+      priority: "standard",
+      status: "reserved"
+    }
+  ]);
+  assert.deepEqual(service.currentBackorders(), []);
+  assert.deepEqual(service.events(), [
+    {
+      type: "order-reserved",
+      orderId: "o-1"
+    }
+  ]);
+});
+
+test("emits exactly one backorder-recorded event for each backorder", () => {
+  const service = createOrderService(createWarehouse({ sku: 2 }));
+
+  service.place({ orderId: "o-2", skuId: "sku", quantity: 5 });
+
+  assert.deepEqual(service.currentOrders(), [
+    {
+      orderId: "o-2",
+      skuId: "sku",
+      quantity: 5,
+      priority: "standard",
+      status: "backordered"
+    }
+  ]);
+  assert.deepEqual(service.currentBackorders(), [
+    {
+      orderId: "o-2",
+      skuId: "sku",
+      missing: 3
+    }
+  ]);
+  assert.deepEqual(service.events(), [
+    {
+      type: "backorder-recorded",
+      orderId: "o-2",
+      skuId: "sku",
+      missing: 3
+    }
+  ]);
+});
