+++ b/src/probe/g6.ts
@@ -0,0 +1,107 @@
+import { pathToFileURL } from "node:url";
+import { WarehouseService } from "../application/warehouse-service.ts";
+import { deriveAnalytics } from "../durability/journal.ts";
+import { computeStateHash, canonicalJson } from "./state-hash.ts";
+
+export interface G6ProbeReport {
+  readonly schemaVersion: 1;
+  readonly increment: "G6";
+  readonly scenario: "thesis-seed-2026";
+  readonly stateHash: string;
+  readonly orders: readonly {
+    readonly id: string;
+    readonly priority: string;
+    readonly status: string;
+  }[];
+  readonly backorders: readonly {
+    readonly orderId: string;
+    readonly priority: string;
+    readonly lines: readonly {
+      readonly skuId: string;
+      readonly requested: number;
+      readonly available: number;
+      readonly missing: number;
+    }[];
+  }[];
+  readonly fulfillmentWaveOrderIds: readonly (readonly string[])[];
+  readonly analytics: {
+    readonly eventCounts: Readonly<Record<string, number>>;
+    readonly orderCreations: number;
+    readonly reservations: number;
+    readonly backorders: number;
+    readonly alerts: readonly string[];
+  };
+}
+
+function sortById<T extends { readonly id?: string; readonly orderId?: string }>(items: readonly T[]): readonly T[] {
+  return [...items].sort((left, right) => {
+    const leftId = left.id ?? left.orderId ?? "";
+    const rightId = right.id ?? right.orderId ?? "";
+    return leftId.localeCompare(rightId);
+  });
+}
+
+export function buildG6ProbeReport(): G6ProbeReport {
+  const service = new WarehouseService();
+  service.createOrder({
+    id: "g6-express",
+    priority: "express",
+    status: "pending",
+    lines: [{ skuId: "SKU-1001", quantity: 2 }],
+  });
+  service.createOrder({
+    id: "g6-standard",
+    priority: "standard",
+    status: "pending",
+    lines: [{ skuId: "SKU-1002", quantity: 2 }],
+  });
+  service.createOrder({
+    id: "g6-backorder",
+    priority: "express",
+    status: "pending",
+    lines: [{ skuId: "SKU-9999", quantity: 1 }],
+  });
+
+  service.reserve("g6-express");
+  service.reserve("g6-standard");
+  service.reserve("g6-backorder");
+  service.transition("g6-backorder", "cancelled");
+
+  const snapshot = service.snapshot();
+  const orders = sortById(snapshot.orders).map((order) => ({
+    id: order.id,
+    priority: order.priority ?? "standard",
+    status: order.status,
+  }));
+  const backorders = sortById(snapshot.backorders).map((backorder) => ({
+    orderId: backorder.orderId,
+    priority: backorder.priority,
+    lines: backorder.lines.map((line) => ({
+      skuId: line.skuId,
+      requested: line.requested,
+      available: line.available,
+      missing: line.missing,
+    })),
+  }));
+  const fulfillmentWaveOrderIds = service.fulfillmentPlan(2).waves.map((wave) => [...wave.orderIds]);
+  const analytics = deriveAnalytics(service.events.history());
+
+  return {
+    schemaVersion: 1,
+    increment: "G6",
+    scenario: "thesis-seed-2026",
+    stateHash: computeStateHash({ orders, backorders, fulfillmentWaveOrderIds }),
+    orders,
+    backorders,
+    fulfillmentWaveOrderIds,
+    analytics,
+  };
+}
+
+export function main(): string {
+  return canonicalJson(buildG6ProbeReport());
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.stdout.write(`${main()}\n`);
+}
