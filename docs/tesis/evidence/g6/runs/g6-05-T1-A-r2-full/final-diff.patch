+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildG6ProbeReport, main } from "./g6.ts";
+
+test("G6 probe is deterministic and surfaces priority and backorders", () => {
+  const first = buildG6ProbeReport();
+  const second = buildG6ProbeReport();
+  assert.deepEqual(first, second);
+  assert.equal(main(), main());
+  assert.equal(first.increment, "G6");
+  assert.equal(first.snapshot.orders[0]?.priority, "standard");
+  assert.equal(first.snapshot.orders[1]?.priority, "express");
+  assert.deepEqual(first.snapshot.orders[2]?.backorders, [{ skuId: "SKU-1002", quantity: 9984 }]);
+  assert.equal(first.plan.waves[0]?.orderIds[0], "g6-express");
+  assert.deepEqual(first.plan.backorders, [{ orderId: "g6-backorder", lines: [{ skuId: "SKU-1002", quantity: 9984 }] }]);
+  assert.match(first.stateHash, /^sha256:[0-9a-f]{64}$/);
+});
