--- /dev/null
+++ b/src/probe/g6.ts
@@ -0,0 +1,40 @@
+import { pathToFileURL } from "node:url";
+import { WarehouseService } from "../application/warehouse-service.ts";
+import { computeStateHash } from "./state-hash.ts";
+
+export interface G6ProbeReport {
+  readonly schemaVersion: 1;
+  readonly increment: "G6";
+  readonly scenario: "thesis-seed-2026";
+  readonly stateHash: string;
+  readonly snapshot: ReturnType<WarehouseService["snapshot"]>;
+  readonly plan: ReturnType<WarehouseService["fulfillmentPlan"]>;
+}
+
+export function buildG6ProbeReport(): G6ProbeReport {
+  const service = new WarehouseService();
+  service.createOrder({ id: "g6-standard", status: "pending", lines: [{ skuId: "SKU-1001", quantity: 1 }] });
+  service.createOrder({ id: "g6-express", status: "pending", priority: "express", lines: [{ skuId: "SKU-1003", quantity: 1 }] });
+  service.createOrder({ id: "g6-backorder", status: "pending", lines: [{ skuId: "SKU-1002", quantity: 9999 }] });
+  service.reserve("g6-standard");
+  service.reserve("g6-express");
+  service.reserve("g6-backorder");
+
+  const snapshot = service.snapshot();
+  return {
+    schemaVersion: 1,
+    increment: "G6",
+    scenario: "thesis-seed-2026",
+    stateHash: computeStateHash(snapshot),
+    snapshot,
+    plan: service.fulfillmentPlan(2),
+  };
+}
+
+export function main(): string {
+  return JSON.stringify(buildG6ProbeReport());
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.stdout.write(`${main()}\n`);
+}
