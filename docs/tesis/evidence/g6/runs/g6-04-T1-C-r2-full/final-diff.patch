+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildG6ProbeReport, main } from "./g6.ts";
+
+test("G6 probe is deterministic and emits a stable JSON object", () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.equal(first, JSON.stringify(buildG6ProbeReport()));
+  assert.deepEqual(JSON.parse(first), JSON.parse(second));
+  assert.deepEqual(Object.keys(JSON.parse(first)), [
+    "schemaVersion",
+    "increment",
+    "scenario",
+    "stateHash",
+    "capabilities",
+  ]);
+  assert.equal(JSON.parse(first).increment, "G6");
+});
