+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { main } from "./g6.ts";
+
+test("G6 probe is deterministic and writes a single JSON object", () => {
+  const first = main();
+  const second = main();
+  assert.equal(first, second);
+  assert.equal(JSON.stringify(JSON.parse(first)), first);
+
+  const script = fileURLToPath(new URL("./g6.ts", import.meta.url));
+  const invocation = spawnSync(process.execPath, [script], { encoding: "utf8" });
+  assert.equal(invocation.status, 0);
+  assert.equal(invocation.stderr, "");
+  assert.equal(invocation.stdout, first);
+});
diff --git a/src/probe/g6.ts b/src/probe/g6.ts
new file mode 100644
index 0000000..5f63671
--- /dev/null
+++ b/src/probe/g6.ts
@@ -0,0 +1,75 @@
+import { pathToFileURL } from "node:url";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { computeStateHash } from "./state-hash.ts";
+import { renderTowerSvg } from "../presentation/tower.ts";
+
+type ProbeOrder = {
+  readonly id: string;
+  readonly status: "reserved";
+  readonly lines: readonly { readonly skuId: string; readonly quantity: number }[];
+  readonly priority: "express" | "standard";
+};
+
+function isExpressOrder(order: ProbeOrder): boolean {
+  return order.priority === "express";
+}
+
+function buildProbeOrders(): readonly ProbeOrder[] {
+  return [
+    {
+      id: "exp-order-1",
+      status: "reserved",
+      lines: [{ skuId: "SKU-1001", quantity: 1 }],
+      priority: "express",
+    },
+    {
+      id: "std-order-1",
+      status: "reserved",
+      lines: [{ skuId: "SKU-1002", quantity: 1 }],
+      priority: "standard",
+    },
+  ];
+}
+
+export function main(): string {
+  const scenario = buildThesisSeed2026();
+  const orders = buildProbeOrders();
+  const towerSnapshot = {
+    scenario: scenario.name,
+    bins: scenario.layout.bins,
+    inventory: [
+      { binId: "bin-1-1", skuId: "SKU-1001", quantity: 4 },
+      { binId: "bin-1-2", skuId: "SKU-1002", quantity: 2 },
+    ],
+    orders,
+  } as const;
+  const towerSvg = renderTowerSvg(towerSnapshot);
+  const expressOrders = orders.filter(isExpressOrder).length;
+  const standardOrders = orders.length - expressOrders;
+
+  return JSON.stringify({
+    schemaVersion: 1,
+    increment: "G6",
+    scenario: scenario.name,
+    stateHash: computeStateHash({
+      scenario: scenario.name,
+      bins: scenario.layout.bins.map((bin) => ({ id: bin.id, zoneId: bin.zoneId, code: bin.code })),
+      orders: orders.map((order) => ({
+        id: order.id,
+        priority: order.priority,
+        status: order.status,
+        lines: order.lines.map((line) => ({ skuId: line.skuId, quantity: line.quantity })),
+      })),
+      towerSvg,
+    }),
+    tower: {
+      expressOrders,
+      standardOrders,
+      svgHash: computeStateHash(towerSvg),
+    },
+  });
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.stdout.write(main());
+}
