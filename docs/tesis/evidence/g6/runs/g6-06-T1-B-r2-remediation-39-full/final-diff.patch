+++ b/src/probe/g6.test.ts
@@ -0,0 +1,23 @@
+import { spawnSync } from "node:child_process";
+import assert from "node:assert/strict";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test } from "node:test";
+import { main } from "./g6.ts";
+
+const scriptPath = join(dirname(fileURLToPath(import.meta.url)), "g6.ts");
+
+test("G6 probe returns deterministic JSON and direct execution writes exactly one object", () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.deepEqual(JSON.parse(first), JSON.parse(second));
+
+  const result = spawnSync(process.execPath, [scriptPath], { encoding: "utf8" });
+
+  assert.equal(result.status, 0);
+  assert.equal(result.stderr, "");
+  assert.equal(result.stdout, first);
+  assert.deepEqual(JSON.parse(result.stdout), JSON.parse(first));
+});
diff --git a/src/probe/g6.ts b/src/probe/g6.ts
new file mode 100644
index 0000000..63f11ce
--- /dev/null
+++ b/src/probe/g6.ts
@@ -0,0 +1,37 @@
+import { pathToFileURL } from "node:url";
+import { computeStateHash } from "./state-hash.ts";
+
+const G6_PROBE_STATE = {
+  increment: "G6",
+  probe: "study:g6-probe",
+  schemaVersion: 1,
+  deterministic: true,
+} as const;
+
+export interface G6ProbeReport {
+  readonly schemaVersion: 1;
+  readonly increment: "G6";
+  readonly probe: "study:g6-probe";
+  readonly deterministic: true;
+  readonly stateHash: string;
+}
+
+export function buildG6ProbeReport(): G6ProbeReport {
+  return {
+    schemaVersion: 1,
+    increment: "G6",
+    probe: "study:g6-probe",
+    deterministic: true,
+    stateHash: computeStateHash(G6_PROBE_STATE),
+  };
+}
+
+export function main(): string {
+  return JSON.stringify(buildG6ProbeReport());
+}
+
+const isMainModule = process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href;
+
+if (isMainModule) {
+  process.stdout.write(main());
+}
