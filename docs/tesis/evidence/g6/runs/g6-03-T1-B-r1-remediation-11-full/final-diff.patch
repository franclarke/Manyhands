+
+export interface Backorder {
+  readonly id: string;
+  readonly orderId: string;
+  readonly skuId: string;
+  readonly quantity: number;
+}
+
+export function listBackorders(state: WarehouseState): readonly Backorder[] {
+  const backorders: Backorder[] = [];
+  for (const order of state.orders.values()) {
+    const recordedBackorders = order.backorders ?? deriveBackorders(state, order);
+    for (const backorder of recordedBackorders) {
+      backorders.push({
+        id: order.id,
+        orderId: order.id,
+        skuId: backorder.skuId,
+        quantity: backorder.quantity,
+      });
+    }
+  }
+  return backorders.sort((left, right) =>
+    left.orderId.localeCompare(right.orderId) || left.skuId.localeCompare(right.skuId) || left.quantity - right.quantity
+  );
+}
