diff --git a/src/probe/g6.test.ts b/src/probe/g6.test.ts
new file mode 100644
index 0000000..62cbbbd
--- /dev/null
+++ b/src/probe/g6.test.ts
@@ -0,0 +1,34 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fileURLToPath } from "node:url";
+import { main } from "./g6.ts";
+
+test("G6 probe is byte-stable and emits exactly one JSON object on direct execution", async () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.equal(JSON.parse(first).increment, "G6");
+
+  const originalArgv = [...process.argv];
+  const originalWrite = process.stdout.write;
+  const probePath = fileURLToPath(new URL("./g6.ts", import.meta.url));
+  const moduleUrl = new URL("./g6.ts", import.meta.url);
+  moduleUrl.search = `direct=${Date.now()}`;
+  let output = "";
+
+  try {
+    process.argv = [originalArgv[0] ?? "node", probePath, ...originalArgv.slice(2)];
+    process.stdout.write = (chunk: string) => {
+      output += chunk;
+    };
+
+    await import(moduleUrl.href);
+  } finally {
+    process.argv = originalArgv;
+    process.stdout.write = originalWrite;
+  }
+
+  assert.equal(output, `${first}\n`);
+  assert.doesNotMatch(output, /\n.+/s);
+});
