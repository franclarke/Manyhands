index 0000000..65b20ab
--- /dev/null
+++ b/src/probe/g6.test.ts
@@ -0,0 +1,35 @@
+import { spawnSync } from "node:child_process";
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { buildProbeReport } from "./cli.ts";
+import { main } from "./g6.ts";
+
+const EXPECTED_REPORT = buildProbeReport({
+  increment: "G6",
+  scenario: "thesis-seed-2026",
+  format: "json",
+});
+
+test("G6 probe is deterministic and matches the shared probe shape", () => {
+  const first = main();
+  const second = main();
+  assert.equal(first, second);
+  assert.equal(first, JSON.stringify(EXPECTED_REPORT));
+
+  const parsed = JSON.parse(first) as typeof EXPECTED_REPORT;
+  assert.deepEqual(parsed, EXPECTED_REPORT);
+  assert.deepEqual(Object.keys(parsed), [
+    "schemaVersion",
+    "increment",
+    "scenario",
+    "stateHash",
+    "capabilities",
+  ]);
+});
+
+test("G6 probe direct execution writes exactly one JSON object and nothing else", () => {
+  const result = spawnSync("node", ["src/probe/g6.ts"], { encoding: "utf8" });
+  assert.equal(result.status, 0);
+  assert.equal(result.stderr, "");
+  assert.equal(result.stdout, `${main()}\n`);
+});
