+++ b/src/probe/g6.test.ts
@@ -0,0 +1,34 @@
+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { main } from "./g6.ts";
+
+const G6_PATH = fileURLToPath(new URL("./g6.ts", import.meta.url));
+
+test("G6 probe returns a deterministic JSON string", () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.deepEqual(JSON.parse(first), {
+    schemaVersion: 1,
+    increment: "G6",
+  });
+});
+
+test("G6 probe direct invocation writes exactly one JSON object and nothing else", () => {
+  const first = spawnSync(process.execPath, [G6_PATH], { encoding: "utf8" });
+  const second = spawnSync(process.execPath, [G6_PATH], { encoding: "utf8" });
+
+  assert.equal(first.status, 0);
+  assert.equal(first.stderr, "");
+  assert.equal(first.stdout, main());
+  assert.deepEqual(JSON.parse(first.stdout), {
+    schemaVersion: 1,
+    increment: "G6",
+  });
+  assert.equal(second.status, 0);
+  assert.equal(second.stderr, "");
+  assert.equal(second.stdout, first.stdout);
+});
