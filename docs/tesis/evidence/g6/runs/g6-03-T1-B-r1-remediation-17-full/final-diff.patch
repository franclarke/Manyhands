+  const orderSummary = orders.length === 0 ? "" : `<g aria-label="Order priorities">${orderCells}</g>`;
+  const height = orders.length === 0 ? 180 : 220 + Math.floor((orders.length - 1) / 4) * 44;
+  return `<section aria-labelledby="tower-title"><h2 id="tower-title">Warehouse tower</h2><p>Heatmap intensity is supplemental; exact quantities are listed below.</p><svg viewBox="0 0 680 ${height}" role="img" aria-labelledby="tower-title tower-description"><desc id="tower-description">Warehouse bins colored by unit quantity, with text labels for every bin.</desc>${cells}${orderSummary}</svg><ul aria-label="Bin details">${details}</ul></section>`;
 }
