+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { fileURLToPath } from "node:url";
+
+const MODULE_URL = new URL("./g6.ts", import.meta.url);
+
+test("G6 probe is deterministic and writes a single JSON object", async () => {
+  const originalWrite = process.stdout.write;
+  const originalArgv1 = process.argv[1];
+  let captured = "";
+
+  try {
+    process.argv[1] = fileURLToPath(MODULE_URL);
+    process.stdout.write = (chunk: string) => {
+      captured += chunk;
+    };
+
+    const { main } = await import("./g6.ts");
+    const output = main();
+
+    assert.equal(captured, output);
+    assert.equal(main(), output);
+    assert.doesNotMatch(captured, /\n/);
+    assert.deepEqual(JSON.parse(captured), JSON.parse(output));
+  } finally {
+    process.stdout.write = originalWrite;
+    process.argv[1] = originalArgv1;
+  }
+});
diff --git a/src/probe/g6.ts b/src/probe/g6.ts
new file mode 100644
index 0000000..1f2855c
--- /dev/null
+++ b/src/probe/g6.ts
@@ -0,0 +1,53 @@
+import { pathToFileURL } from "node:url";
+import { countBins, countZones } from "../domain/layout.ts";
+import { countSkus, totalUnits } from "../domain/inventory.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { computeStateHash } from "./state-hash.ts";
+
+const SCHEMA_VERSION = 1;
+
+export interface G6ProbeReport {
+  readonly schemaVersion: number;
+  readonly increment: "G6";
+  readonly scenario: "thesis-seed-2026";
+  readonly stateHash: string;
+  readonly capabilities: {
+    readonly layout: {
+      readonly zones: number;
+      readonly bins: number;
+    };
+    readonly inventory: {
+      readonly skus: number;
+      readonly totalUnits: number;
+    };
+  };
+}
+
+export function main(): string {
+  const scenario = buildThesisSeed2026();
+
+  return JSON.stringify({
+    schemaVersion: SCHEMA_VERSION,
+    increment: "G6",
+    scenario: "thesis-seed-2026",
+    stateHash: computeStateHash({
+      scenario: scenario.name,
+      layout: scenario.layout,
+      quantities: scenario.inventory.quantities,
+    }),
+    capabilities: {
+      layout: {
+        zones: countZones(scenario.layout),
+        bins: countBins(scenario.layout),
+      },
+      inventory: {
+        skus: countSkus(scenario.inventory),
+        totalUnits: totalUnits(scenario.inventory),
+      },
+    },
+  });
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.stdout.write(main());
+}
