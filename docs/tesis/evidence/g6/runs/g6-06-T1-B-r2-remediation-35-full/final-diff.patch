+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { main } from "./g6.ts";
+
+test("G6 probe is deterministic and emits a stable JSON string", () => {
+  const first = main();
+  const second = main();
+  assert.equal(first, second);
+  assert.doesNotMatch(first, /\n/);
+  assert.deepEqual(JSON.parse(first), JSON.parse(second));
+  assert.equal(JSON.parse(first).increment, "G6");
+  assert.equal(JSON.parse(first).scenario, "thesis-seed-2026");
+  assert.equal(JSON.parse(first).schemaVersion, 1);
+});
