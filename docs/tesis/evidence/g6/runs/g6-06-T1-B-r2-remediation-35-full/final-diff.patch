+      return `<g data-order-id="${escape(order.id)}" data-order-priority="${escape(order.priority)}" transform="translate(${x},${y})"><rect width="148" height="36" rx="8" fill="${fill}" opacity="0.94"/><text x="12" y="15" fill="white" font-size="10" font-weight="700">${escape(label)}</text><text x="12" y="28" fill="white" font-size="11">${escape(order.id)}</text></g>`;
