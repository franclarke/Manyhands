+test("G6 probe is byte deterministic and reports priority and backorder tracking", () => {
+  assert.equal(main(), main());
+  const report = JSON.parse(main()) as {
+    firstWaveOrderIds: string[];
+    backorderCount: number;
+    analyticsBackorders: number;
+    overlayDistinguishesPriority: boolean;
+  };
+  assert.deepEqual(report.firstWaveOrderIds, ["g6-express", "g6-standard"]);
+  assert.equal(report.backorderCount, 1);
+  assert.equal(report.analyticsBackorders, 1);
+  assert.equal(report.overlayDistinguishesPriority, true);
