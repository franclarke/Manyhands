new file mode 100644
index 0000000..7cba2a3
--- /dev/null
+++ b/src/probe/g6.ts
@@ -0,0 +1,35 @@
+import { pathToFileURL } from "node:url";
+import { WarehouseService } from "../application/warehouse-service.ts";
+import { deriveAnalytics } from "../durability/journal.ts";
+
+export function main(): string {
+  const service = new WarehouseService();
+  service.createOrder({ id: "g6-express", status: "pending", priority: "express", lines: [{ skuId: "SKU-1001", quantity: 2 }] });
+  service.createOrder({ id: "g6-standard", status: "pending", priority: "standard", lines: [{ skuId: "SKU-1003", quantity: 2 }] });
+  service.createOrder({ id: "g6-backorder", status: "pending", lines: [{ skuId: "SKU-1005", quantity: 999999 }] });
+
+  service.reserve("g6-express");
+  service.reserve("g6-standard");
+  service.reserve("g6-backorder");
+
+  const plan = service.fulfillmentPlan(2);
+  const overlay = service.fulfillmentOverlay(2);
+  const analytics = deriveAnalytics(service.events.history());
+  const backorders = service.backorders();
+
+  return JSON.stringify({
+    schemaVersion: 1,
+    increment: "G6",
+    scenario: "thesis-seed-2026",
+    priorities: service.snapshot().orders.map((order) => ({ id: order.id, priority: order.priority ?? "standard" })),
+    firstWaveOrderIds: plan.waves[0]?.orderIds ?? [],
+    backorderCount: backorders.length,
+    backorders,
+    analyticsBackorders: analytics.backorders,
+    overlayDistinguishesPriority: overlay.includes('data-priority="express"') && overlay.includes('data-priority="standard"'),
+  });
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  process.stdout.write(`${main()}\n`);
+}
