+export const EXPENSE_CATEGORIES = ["food", "transportation", "travel", "lodging", "housing", "utilities", "entertainment", "supplies", "other"] as const;
+export type ExpenseCategory = (typeof EXPENSE_CATEGORIES)[number];
+export const UNCATEGORIZED_EXPENSE_CATEGORY = "uncategorized" as const;
+
 export interface Expense {
   id: string;
   description: string;
   amountCents: number;
   paidByParticipantId: string;
   sharedWithParticipantIds: string[];
