index 0000000..0b73a7d
--- /dev/null
+++ b/src/scenarios/thesis-seed-2026.ts
@@ -0,0 +1,69 @@
+import { type Bin, createLayout, type Layout, type Zone } from "../domain/layout.ts";
+import { createInventory, ingreso, type InventoryState } from "../domain/inventory.ts";
+
+export const THESIS_SEED_2026 = "thesis-seed-2026";
+
+export interface Scenario {
+  readonly name: string;
+  readonly layout: Layout;
+  readonly inventory: InventoryState;
+  readonly skus: readonly string[];
+}
+
+const ZONE_NAMES = ["Receiving", "Bulk Storage", "Pick Face", "Shipping"];
+const BINS_PER_ZONE = 4;
+const SKUS = ["SKU-1001", "SKU-1002", "SKU-1003", "SKU-1004", "SKU-1005"];
+
+function buildLayout(): Layout {
+  const zones: Zone[] = ZONE_NAMES.map((name, index) => ({
+    id: `zone-${index + 1}`,
+    name,
+  }));
+
+  const bins: Bin[] = [];
+  zones.forEach((zone, zoneIndex) => {
+    for (let slot = 1; slot <= BINS_PER_ZONE; slot += 1) {
+      bins.push({
+        id: `bin-${zoneIndex + 1}-${slot}`,
+        zoneId: zone.id,
+        code: `${zone.id.toUpperCase()}-${String(slot).padStart(2, "0")}`,
+      });
+    }
+  });
+
+  return createLayout(zones, bins);
+}
+
+function buildInventory(layout: Layout): InventoryState {
+  let state = createInventory(layout.bins.map((bin) => bin.id));
+
+  const stockPlan: ReadonlyArray<readonly [binId: string, skuId: string, qty: number]> = [
+    ["bin-1-1", SKUS[0], 20],
+    ["bin-1-2", SKUS[1], 15],
+    ["bin-2-1", SKUS[2], 30],
+    ["bin-2-2", SKUS[0], 10],
+    ["bin-3-1", SKUS[3], 25],
+    ["bin-3-2", SKUS[4], 40],
+    ["bin-4-1", SKUS[2], 12],
+    ["bin-4-2", SKUS[3], 18],
+  ];
+
+  for (const [binId, skuId, qty] of stockPlan) {
+    state = ingreso(state, binId, skuId, qty);
+  }
+
+  return state;
+}
+
+export function buildThesisSeed2026(): Scenario {
+  const layout = buildLayout();
+  const inventory = buildInventory(layout);
+  return { name: THESIS_SEED_2026, layout, inventory, skus: SKUS };
+}
+
+export function getScenario(name: string): Scenario {
+  if (name === THESIS_SEED_2026) {
+    return buildThesisSeed2026();
+  }
+  throw new Error(`unknown scenario: ${name}`);
+}
