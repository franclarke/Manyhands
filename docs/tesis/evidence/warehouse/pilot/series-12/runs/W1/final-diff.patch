+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countBins, countZones } from "../domain/layout.ts";
+import { countSkus, totalUnits } from "../domain/inventory.ts";
+import { buildThesisSeed2026, getScenario, THESIS_SEED_2026 } from "./thesis-seed-2026.ts";
+
+test("thesis-seed-2026 meets the W1 layout and inventory minimums", () => {
+  const scenario = buildThesisSeed2026();
+  assert.ok(countZones(scenario.layout) >= 3);
+  assert.ok(countBins(scenario.layout) >= 12);
+  assert.ok(countSkus(scenario.inventory) >= 3);
+  assert.ok(totalUnits(scenario.inventory) >= 1);
+});
+
+test("buildThesisSeed2026 is deterministic across invocations", () => {
+  const a = buildThesisSeed2026();
+  const b = buildThesisSeed2026();
+  assert.deepEqual(a.layout, b.layout);
+  assert.deepEqual([...a.inventory.quantities], [...b.inventory.quantities]);
+});
+
+test("getScenario resolves the thesis-seed-2026 scenario by name", () => {
+  const scenario = getScenario(THESIS_SEED_2026);
+  assert.equal(scenario.name, THESIS_SEED_2026);
+});
+
+test("getScenario rejects an unknown scenario name", () => {
+  assert.throws(() => getScenario("does-not-exist"));
+});
diff --git a/src/scenarios/thesis-seed-2026.ts b/src/scenarios/thesis-seed-2026.ts
