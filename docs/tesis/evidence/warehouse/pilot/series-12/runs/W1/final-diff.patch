+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildProbeReport, main, parseArgs, ProbeArgsError } from "./cli.ts";
+
+const ARGV = ["--increment", "W1", "--scenario", "thesis-seed-2026", "--format", "json"];
+
+test("parseArgs reads increment, scenario, and format flags", () => {
+  const args = parseArgs(ARGV);
+  assert.deepEqual(args, { increment: "W1", scenario: "thesis-seed-2026", format: "json" });
+});
+
+test("parseArgs rejects a missing required flag", () => {
+  assert.throws(() => parseArgs(["--increment", "W1"]), ProbeArgsError);
+});
+
+test("parseArgs rejects an unsupported format", () => {
+  assert.throws(
+    () => parseArgs(["--increment", "W1", "--scenario", "thesis-seed-2026", "--format", "xml"]),
+    ProbeArgsError,
+  );
+});
+
+test("buildProbeReport emits the required envelope shape and capability minimums", () => {
+  const report = buildProbeReport(parseArgs(ARGV));
+  assert.deepEqual(Object.keys(report), [
+    "schemaVersion",
+    "increment",
+    "scenario",
+    "stateHash",
+    "capabilities",
+  ]);
+  assert.equal(report.schemaVersion, 1);
+  assert.equal(report.increment, "W1");
+  assert.equal(report.scenario, "thesis-seed-2026");
+  assert.match(report.stateHash, /^sha256:[0-9a-f]{64}$/);
+  assert.deepEqual(Object.keys(report.capabilities), ["layout", "inventory"]);
+  assert.deepEqual(Object.keys(report.capabilities.layout), ["zones", "bins"]);
+  assert.deepEqual(Object.keys(report.capabilities.inventory), ["skus", "totalUnits"]);
+  assert.ok(report.capabilities.layout.zones >= 3);
+  assert.ok(report.capabilities.layout.bins >= 12);
+  assert.ok(report.capabilities.inventory.skus >= 3);
+  assert.ok(report.capabilities.inventory.totalUnits >= 1);
+});
+
+test("main produces identical bytes across repeated invocations", () => {
+  const first = main(ARGV);
+  const second = main(ARGV);
+  assert.equal(first, second);
+  assert.deepEqual(JSON.parse(first), JSON.parse(second));
+});
diff --git a/src/probe/cli.ts b/src/probe/cli.ts
new file mode 100644
index 0000000..a02524f
--- /dev/null
+++ b/src/probe/cli.ts
@@ -0,0 +1,103 @@
+import { pathToFileURL } from "node:url";
+import { countBins, countZones } from "../domain/layout.ts";
+import { countSkus, totalUnits } from "../domain/inventory.ts";
+import { getScenario } from "../scenarios/thesis-seed-2026.ts";
+import { computeStateHash } from "./state-hash.ts";
+
+const SCHEMA_VERSION = 1;
+
+export interface ProbeArgs {
+  readonly increment: string;
+  readonly scenario: string;
+  readonly format: string;
+}
+
+export class ProbeArgsError extends Error {}
+
+export interface ProbeReport {
+  readonly schemaVersion: number;
+  readonly increment: string;
+  readonly scenario: string;
+  readonly stateHash: string;
+  readonly capabilities: {
+    readonly layout: {
+      readonly zones: number;
+      readonly bins: number;
+    };
+    readonly inventory: {
+      readonly skus: number;
+      readonly totalUnits: number;
+    };
+  };
+}
+
+export function parseArgs(argv: readonly string[]): ProbeArgs {
+  const flags = new Map<string, string>();
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg?.startsWith("--")) {
+      const name = arg.slice(2);
+      const value = argv[i + 1];
+      if (value === undefined || value.startsWith("--")) {
+        throw new ProbeArgsError(`missing value for flag: --${name}`);
+      }
+      flags.set(name, value);
+      i += 1;
+    }
+  }
+
+  const increment = flags.get("increment");
+  const scenario = flags.get("scenario");
+  const format = flags.get("format");
+
+  if (!increment) throw new ProbeArgsError("missing required flag: --increment");
+  if (!scenario) throw new ProbeArgsError("missing required flag: --scenario");
+  if (!format) throw new ProbeArgsError("missing required flag: --format");
+  if (format !== "json") throw new ProbeArgsError(`unsupported format: ${format}`);
+
+  return { increment, scenario, format };
+}
+
+export function buildProbeReport(args: ProbeArgs): ProbeReport {
+  const scenario = getScenario(args.scenario);
+
+  const layoutCapability = {
+    zones: countZones(scenario.layout),
+    bins: countBins(scenario.layout),
+  };
+
+  const inventoryCapability = {
+    skus: countSkus(scenario.inventory),
+    totalUnits: totalUnits(scenario.inventory),
+  };
+
+  const stateHash = computeStateHash({
+    scenario: scenario.name,
+    layout: scenario.layout,
+    quantities: scenario.inventory.quantities,
+  });
+
+  return {
+    schemaVersion: SCHEMA_VERSION,
+    increment: args.increment,
+    scenario: args.scenario,
+    stateHash,
+    capabilities: {
+      layout: layoutCapability,
+      inventory: inventoryCapability,
+    },
+  };
+}
+
+export function main(argv: readonly string[]): string {
+  const args = parseArgs(argv);
+  const report = buildProbeReport(args);
+  return JSON.stringify(report, null, 2);
+}
+
+const isMainModule = process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href;
+
+if (isMainModule) {
+  const cliArgs = process.argv.slice(2).filter((arg) => arg !== "--");
+  process.stdout.write(`${main(cliArgs)}\n`);
+}
