+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { binIds, countBins, countZones, createLayout, hasBin, LayoutError } from "./layout.ts";
+
+function sampleLayout() {
+  return createLayout(
+    [
+      { id: "zone-a", name: "Zone A" },
+      { id: "zone-b", name: "Zone B" },
+    ],
+    [
+      { id: "bin-1", zoneId: "zone-a", code: "A-01" },
+      { id: "bin-2", zoneId: "zone-a", code: "A-02" },
+      { id: "bin-3", zoneId: "zone-b", code: "B-01" },
+    ],
+  );
+}
+
+test("createLayout builds a layout with the given zones and bins", () => {
+  const layout = sampleLayout();
+  assert.equal(countZones(layout), 2);
+  assert.equal(countBins(layout), 3);
+  assert.deepEqual(binIds(layout), ["bin-1", "bin-2", "bin-3"]);
+});
+
+test("hasBin reports whether a bin id exists in the layout", () => {
+  const layout = sampleLayout();
+  assert.equal(hasBin(layout, "bin-1"), true);
+  assert.equal(hasBin(layout, "bin-999"), false);
+});
+
+test("createLayout rejects a bin referencing an unknown zone", () => {
+  assert.throws(
+    () =>
+      createLayout(
+        [{ id: "zone-a", name: "Zone A" }],
+        [{ id: "bin-1", zoneId: "zone-missing", code: "A-01" }],
+      ),
+    LayoutError,
+  );
+});
+
+test("createLayout rejects duplicate zone ids", () => {
+  assert.throws(
+    () =>
+      createLayout(
+        [
+          { id: "zone-a", name: "Zone A" },
+          { id: "zone-a", name: "Zone A duplicate" },
+        ],
+        [],
+      ),
+    LayoutError,
+  );
+});
+
+test("createLayout rejects duplicate bin ids", () => {
+  assert.throws(
+    () =>
+      createLayout(
+        [{ id: "zone-a", name: "Zone A" }],
+        [
+          { id: "bin-1", zoneId: "zone-a", code: "A-01" },
+          { id: "bin-1", zoneId: "zone-a", code: "A-02" },
+        ],
+      ),
+    LayoutError,
+  );
+});
diff --git a/src/domain/layout.ts b/src/domain/layout.ts
new file mode 100644
index 0000000..5de02fe
--- /dev/null
+++ b/src/domain/layout.ts
@@ -0,0 +1,56 @@
+export interface Zone {
+  readonly id: string;
+  readonly name: string;
+}
+
+export interface Bin {
+  readonly id: string;
+  readonly zoneId: string;
+  readonly code: string;
+}
+
+export interface Layout {
+  readonly zones: readonly Zone[];
+  readonly bins: readonly Bin[];
+}
+
+export class LayoutError extends Error {}
+
+export function createLayout(zones: readonly Zone[], bins: readonly Bin[]): Layout {
+  const zoneIds = new Set<string>();
+  for (const zone of zones) {
+    if (zoneIds.has(zone.id)) {
+      throw new LayoutError(`duplicate zone id: ${zone.id}`);
+    }
+    zoneIds.add(zone.id);
+  }
+
+  const binIds = new Set<string>();
+  for (const bin of bins) {
+    if (binIds.has(bin.id)) {
+      throw new LayoutError(`duplicate bin id: ${bin.id}`);
+    }
+    if (!zoneIds.has(bin.zoneId)) {
+      throw new LayoutError(`bin ${bin.id} references unknown zone: ${bin.zoneId}`);
+    }
+    binIds.add(bin.id);
+  }
+
+  return { zones: [...zones], bins: [...bins] };
+}
+
+export function countZones(layout: Layout): number {
+  return layout.zones.length;
+}
+
+export function countBins(layout: Layout): number {
+  return layout.bins.length;
+}
+
+export function binIds(layout: Layout): string[] {
+  return layout.bins.map((bin) => bin.id);
+}
+
+export function hasBin(layout: Layout, binId: string): boolean {
+  return layout.bins.some((bin) => bin.id === binId);
+}
