+++ b/src/domain/inventory.test.ts
@@ -0,0 +1,78 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  countSkus,
+  createInventory,
+  getQuantity,
+  ingreso,
+  InventoryError,
+  retiro,
+  totalUnits,
+  transferencia,
+} from "./inventory.ts";
+
+function sampleInventory() {
+  return createInventory(["bin-1", "bin-2", "bin-3"]);
+}
+
+test("ingreso adds stock to a known bin", () => {
+  const state = ingreso(sampleInventory(), "bin-1", "sku-a", 10);
+  assert.equal(getQuantity(state, "bin-1", "sku-a"), 10);
+  assert.equal(totalUnits(state), 10);
+});
+
+test("ingreso rejects an unknown bin", () => {
+  assert.throws(() => ingreso(sampleInventory(), "bin-999", "sku-a", 10), InventoryError);
+});
+
+test("ingreso rejects a non-positive quantity", () => {
+  assert.throws(() => ingreso(sampleInventory(), "bin-1", "sku-a", 0), InventoryError);
+  assert.throws(() => ingreso(sampleInventory(), "bin-1", "sku-a", -5), InventoryError);
+});
+
+test("retiro removes stock and preserves total quantity", () => {
+  let state = ingreso(sampleInventory(), "bin-1", "sku-a", 10);
+  state = retiro(state, "bin-1", "sku-a", 4);
+  assert.equal(getQuantity(state, "bin-1", "sku-a"), 6);
+  assert.equal(totalUnits(state), 6);
+});
+
+test("retiro rejects driving a bin/sku quantity negative", () => {
+  const state = ingreso(sampleInventory(), "bin-1", "sku-a", 5);
+  assert.throws(() => retiro(state, "bin-1", "sku-a", 6), InventoryError);
+});
+
+test("retiro rejects an unknown bin", () => {
+  assert.throws(() => retiro(sampleInventory(), "bin-999", "sku-a", 1), InventoryError);
+});
+
+test("transferencia moves stock between bins preserving the total", () => {
+  let state = ingreso(sampleInventory(), "bin-1", "sku-a", 10);
+  const before = totalUnits(state);
+  state = transferencia(state, "bin-1", "bin-2", "sku-a", 4);
+  assert.equal(getQuantity(state, "bin-1", "sku-a"), 6);
+  assert.equal(getQuantity(state, "bin-2", "sku-a"), 4);
+  assert.equal(totalUnits(state), before);
+});
+
+test("transferencia rejects when the source would go negative", () => {
+  const state = ingreso(sampleInventory(), "bin-1", "sku-a", 3);
+  assert.throws(() => transferencia(state, "bin-1", "bin-2", "sku-a", 4), InventoryError);
+});
+
+test("transferencia rejects an unknown destination bin", () => {
+  const state = ingreso(sampleInventory(), "bin-1", "sku-a", 10);
+  assert.throws(() => transferencia(state, "bin-1", "bin-999", "sku-a", 4), InventoryError);
+});
+
+test("transferencia rejects an unknown source bin", () => {
+  const state = ingreso(sampleInventory(), "bin-1", "sku-a", 10);
+  assert.throws(() => transferencia(state, "bin-999", "bin-1", "sku-a", 4), InventoryError);
+});
+
+test("countSkus only counts skus with positive stock", () => {
+  let state = ingreso(sampleInventory(), "bin-1", "sku-a", 5);
+  state = ingreso(state, "bin-2", "sku-b", 5);
+  state = retiro(state, "bin-2", "sku-b", 5);
+  assert.equal(countSkus(state), 1);
+});
diff --git a/src/domain/inventory.ts b/src/domain/inventory.ts
new file mode 100644
index 0000000..e948774
--- /dev/null
+++ b/src/domain/inventory.ts
@@ -0,0 +1,96 @@
+export class InventoryError extends Error {}
+
+function stockKey(binId: string, skuId: string): string {
+  return `${binId}::${skuId}`;
+}
+
+export interface InventoryState {
+  readonly binIds: ReadonlySet<string>;
+  readonly quantities: ReadonlyMap<string, number>;
+}
+
+export function createInventory(binIds: Iterable<string>): InventoryState {
+  return { binIds: new Set(binIds), quantities: new Map() };
+}
+
+export function getQuantity(state: InventoryState, binId: string, skuId: string): number {
+  return state.quantities.get(stockKey(binId, skuId)) ?? 0;
+}
+
+function assertKnownBin(state: InventoryState, binId: string): void {
+  if (!state.binIds.has(binId)) {
+    throw new InventoryError(`unknown bin: ${binId}`);
+  }
+}
+
+function assertPositiveQty(qty: number): void {
+  if (!Number.isFinite(qty) || qty <= 0) {
+    throw new InventoryError(`quantity must be a positive number, got: ${qty}`);
+  }
+}
+
+function withQuantity(state: InventoryState, binId: string, skuId: string, qty: number): InventoryState {
+  const quantities = new Map(state.quantities);
+  if (qty === 0) {
+    quantities.delete(stockKey(binId, skuId));
+  } else {
+    quantities.set(stockKey(binId, skuId), qty);
+  }
+  return { binIds: state.binIds, quantities };
+}
+
+export function ingreso(state: InventoryState, binId: string, skuId: string, qty: number): InventoryState {
+  assertKnownBin(state, binId);
+  assertPositiveQty(qty);
+  const next = getQuantity(state, binId, skuId) + qty;
+  return withQuantity(state, binId, skuId, next);
+}
+
+export function retiro(state: InventoryState, binId: string, skuId: string, qty: number): InventoryState {
+  assertKnownBin(state, binId);
+  assertPositiveQty(qty);
+  const current = getQuantity(state, binId, skuId);
+  const next = current - qty;
+  if (next < 0) {
+    throw new InventoryError(
+      `retiro would drive bin ${binId} / sku ${skuId} negative: ${current} - ${qty}`,
+    );
+  }
+  return withQuantity(state, binId, skuId, next);
+}
+
+export function transferencia(
+  state: InventoryState,
+  fromBinId: string,
+  toBinId: string,
+  skuId: string,
+  qty: number,
+): InventoryState {
+  assertKnownBin(state, fromBinId);
+  assertKnownBin(state, toBinId);
+  const afterRetiro = retiro(state, fromBinId, skuId, qty);
+  return ingreso(afterRetiro, toBinId, skuId, qty);
+}
+
+export function skuIds(state: InventoryState): string[] {
+  const skus = new Set<string>();
+  for (const key of state.quantities.keys()) {
+    const skuId = key.split("::")[1];
+    if (skuId !== undefined) {
+      skus.add(skuId);
+    }
+  }
+  return [...skus];
+}
+
+export function countSkus(state: InventoryState): number {
+  return skuIds(state).length;
+}
+
+export function totalUnits(state: InventoryState): number {
+  let total = 0;
+  for (const qty of state.quantities.values()) {
+    total += qty;
+  }
+  return total;
+}
