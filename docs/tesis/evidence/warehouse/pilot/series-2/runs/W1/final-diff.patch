+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+
+describe("study probe contract", () => {
+  it("emits one deterministic JSON object for W1 thesis-seed-2026", () => {
+    const args = [
+      "dist/src/cli/study-probe.js",
+      "--",
+      "--increment",
+      "W1",
+      "--scenario",
+      "thesis-seed-2026",
+      "--format",
+      "json",
+    ];
+
+    const first = execFileSync(process.execPath, args, { encoding: "utf8" });
+    const second = execFileSync(process.execPath, args, { encoding: "utf8" });
+
+    assert.equal(first, second);
+    assert.match(first, /^\{.*\}\n$/s);
+
+    const payload = JSON.parse(first);
+    assert.equal(payload.schemaVersion, 1);
+    assert.equal(payload.increment, "W1");
+    assert.equal(payload.scenario, "thesis-seed-2026");
+    assert.equal(typeof payload.stateHash, "string");
+    assert.equal(payload.layout.zones.length, 3);
+    assert.equal(payload.layout.bins.length, 12);
+    assert.equal(payload.inventory.skus.length, 3);
+    assert.deepEqual(payload.capabilities.inventoryOperations, ["ingress", "withdrawal", "transfer"]);
+  });
+});
