diff --git a/tests/domain/inventory-operations.test.ts b/tests/domain/inventory-operations.test.ts
new file mode 100644
index 0000000..f84bad4
--- /dev/null
+++ b/tests/domain/inventory-operations.test.ts
@@ -0,0 +1,105 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  getStockQuantity,
+  receiveStock,
+  totalQuantity,
+  transferStock,
+  withdrawStock,
+} from "../../src/domain/inventory.js";
+import { THESIS_SEED_2026, loadScenario } from "../../src/domain/scenarios.js";
+
+describe("inventory operations", () => {
+  it("ingresses stock by the requested quantity", () => {
+    const state = loadScenario(THESIS_SEED_2026);
+    const before = getStockQuantity(state.inventory, "RCV-01", "SKU-ALPHA");
+
+    const inventory = receiveStock(state.inventory, state.layout, {
+      binId: "RCV-01",
+      skuId: "SKU-ALPHA",
+      quantity: 10,
+    });
+
+    assert.equal(getStockQuantity(inventory, "RCV-01", "SKU-ALPHA"), before + 10);
+    assert.equal(totalQuantity(inventory, "SKU-ALPHA"), totalQuantity(state.inventory, "SKU-ALPHA") + 10);
+  });
+
+  it("withdraws stock by the requested quantity", () => {
+    const state = loadScenario(THESIS_SEED_2026);
+
+    const inventory = withdrawStock(state.inventory, state.layout, {
+      binId: "PCK-01",
+      skuId: "SKU-ALPHA",
+      quantity: 4,
+    });
+
+    assert.equal(getStockQuantity(inventory, "PCK-01", "SKU-ALPHA"), 20);
+    assert.equal(totalQuantity(inventory, "SKU-ALPHA"), totalQuantity(state.inventory, "SKU-ALPHA") - 4);
+  });
+
+  it("transfers stock without changing the total quantity", () => {
+    const state = loadScenario(THESIS_SEED_2026);
+
+    const inventory = transferStock(state.inventory, state.layout, {
+      fromBinId: "RSV-A01",
+      toBinId: "PCK-01",
+      skuId: "SKU-ALPHA",
+      quantity: 12,
+    });
+
+    assert.equal(getStockQuantity(inventory, "RSV-A01", "SKU-ALPHA"), 108);
+    assert.equal(getStockQuantity(inventory, "PCK-01", "SKU-ALPHA"), 36);
+    assert.equal(totalQuantity(inventory, "SKU-ALPHA"), totalQuantity(state.inventory, "SKU-ALPHA"));
+  });
+
+  it("rejects withdrawals and transfers that would create negative stock", () => {
+    const state = loadScenario(THESIS_SEED_2026);
+
+    assert.throws(
+      () =>
+        withdrawStock(state.inventory, state.layout, {
+          binId: "PCK-01",
+          skuId: "SKU-ALPHA",
+          quantity: 25,
+        }),
+      /Insufficient stock/,
+    );
+
+    assert.throws(
+      () =>
+        transferStock(state.inventory, state.layout, {
+          fromBinId: "PCK-01",
+          toBinId: "PCK-02",
+          skuId: "SKU-ALPHA",
+          quantity: 25,
+        }),
+      /Insufficient stock/,
+    );
+  });
+
+  it("rejects unknown bins", () => {
+    const state = loadScenario(THESIS_SEED_2026);
+
+    assert.throws(
+      () =>
+        receiveStock(state.inventory, state.layout, {
+          binId: "MISSING",
+          skuId: "SKU-ALPHA",
+          quantity: 1,
+        }),
+      /Unknown bin/,
+    );
+
+    assert.throws(
+      () =>
+        transferStock(state.inventory, state.layout, {
+          fromBinId: "RSV-A01",
+          toBinId: "MISSING",
+          skuId: "SKU-ALPHA",
+          quantity: 1,
+        }),
+      /Unknown bin/,
+    );
+  });
+});
