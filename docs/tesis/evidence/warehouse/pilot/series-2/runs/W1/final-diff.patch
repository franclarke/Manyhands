+import { createInventory } from "./inventory.js";
+import { createLayout } from "./layout.js";
+import { createWarehouseState, type WarehouseState } from "./state.js";
+
+export const THESIS_SEED_2026 = "thesis-seed-2026";
+
+export function loadScenario(scenario: string): WarehouseState {
+  if (scenario !== THESIS_SEED_2026) {
+    throw new Error(`Unknown scenario: ${scenario}`);
+  }
+
+  const layout = createLayout(
+    [
+      { id: "receiving", name: "Receiving" },
+      { id: "reserve", name: "Reserve Storage" },
+      { id: "picking", name: "Forward Picking" },
+    ],
+    [
+      { id: "RCV-01", zoneId: "receiving", label: "Receiving Dock 1" },
+      { id: "RCV-02", zoneId: "receiving", label: "Receiving Dock 2" },
+      { id: "RCV-03", zoneId: "receiving", label: "Receiving Staging 1" },
+      { id: "RSV-A01", zoneId: "reserve", label: "Reserve A01" },
+      { id: "RSV-A02", zoneId: "reserve", label: "Reserve A02" },
+      { id: "RSV-A03", zoneId: "reserve", label: "Reserve A03" },
+      { id: "RSV-B01", zoneId: "reserve", label: "Reserve B01" },
+      { id: "RSV-B02", zoneId: "reserve", label: "Reserve B02" },
+      { id: "RSV-B03", zoneId: "reserve", label: "Reserve B03" },
+      { id: "PCK-01", zoneId: "picking", label: "Pick Face 1" },
+      { id: "PCK-02", zoneId: "picking", label: "Pick Face 2" },
+      { id: "PCK-03", zoneId: "picking", label: "Pick Face 3" },
+    ],
+  );
+
+  const inventory = createInventory(
+    [
+      { id: "SKU-ALPHA", description: "Ambient control module" },
+      { id: "SKU-BRAVO", description: "Pallet sensor kit" },
+      { id: "SKU-CHARLIE", description: "Rechargeable scanner battery" },
+    ],
+    [
+      { binId: "RSV-A01", skuId: "SKU-ALPHA", quantity: 120 },
+      { binId: "PCK-01", skuId: "SKU-ALPHA", quantity: 24 },
+      { binId: "RSV-A02", skuId: "SKU-BRAVO", quantity: 80 },
+      { binId: "PCK-02", skuId: "SKU-BRAVO", quantity: 18 },
+      { binId: "RSV-B01", skuId: "SKU-CHARLIE", quantity: 200 },
+      { binId: "PCK-03", skuId: "SKU-CHARLIE", quantity: 36 },
+    ],
+    layout,
+  );
+
+  return createWarehouseState(scenario, layout, inventory);
+}
