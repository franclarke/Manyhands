@@ -0,0 +1,67 @@
+export type ZoneId = string;
+export type BinId = string;
+
+export interface Zone {
+  readonly id: ZoneId;
+  readonly name: string;
+}
+
+export interface Bin {
+  readonly id: BinId;
+  readonly zoneId: ZoneId;
+  readonly label: string;
+}
+
+export interface Layout {
+  readonly zones: readonly Zone[];
+  readonly bins: readonly Bin[];
+}
+
+export function createLayout(zones: readonly Zone[], bins: readonly Bin[]): Layout {
+  const zoneIds = new Set<string>();
+
+  for (const zone of zones) {
+    if (!zone.id) {
+      throw new Error("Zone id is required.");
+    }
+
+    if (zoneIds.has(zone.id)) {
+      throw new Error(`Duplicate zone id: ${zone.id}`);
+    }
+
+    zoneIds.add(zone.id);
+  }
+
+  const binIds = new Set<string>();
+
+  for (const bin of bins) {
+    if (!bin.id) {
+      throw new Error("Bin id is required.");
+    }
+
+    if (binIds.has(bin.id)) {
+      throw new Error(`Duplicate bin id: ${bin.id}`);
+    }
+
+    if (!zoneIds.has(bin.zoneId)) {
+      throw new Error(`Bin ${bin.id} references unknown zone ${bin.zoneId}.`);
+    }
+
+    binIds.add(bin.id);
+  }
+
+  return {
+    zones: zones.map((zone) => ({ ...zone })),
+    bins: bins.map((bin) => ({ ...bin })),
+  };
+}
+
+export function hasBin(layout: Layout, binId: BinId): boolean {
+  return layout.bins.some((bin) => bin.id === binId);
+}
+
+export function assertKnownBin(layout: Layout, binId: BinId): void {
+  if (!hasBin(layout, binId)) {
+    throw new Error(`Unknown bin: ${binId}`);
+  }
+}
