diff --git a/src/cli/study-probe.ts b/src/cli/study-probe.ts
new file mode 100644
index 0000000..5a0b698
--- /dev/null
+++ b/src/cli/study-probe.ts
@@ -0,0 +1,70 @@
+import { loadScenario } from "../domain/scenarios.js";
+import { stateHash } from "../domain/state-hash.js";
+
+interface ProbeArgs {
+  readonly increment: string;
+  readonly scenario: string;
+  readonly format: "json";
+}
+
+const args = parseArgs(process.argv.slice(2));
+const state = loadScenario(args.scenario);
+
+if (args.increment !== "W1") {
+  throw new Error(`Unsupported increment: ${args.increment}`);
+}
+
+const payload = {
+  schemaVersion: 1,
+  increment: args.increment,
+  scenario: state.scenario,
+  stateHash: stateHash(state),
+  capabilities: {
+    inventoryOperations: ["ingress", "withdrawal", "transfer"],
+    rejects: ["unknown-bin", "unknown-sku", "non-positive-quantity", "negative-stock"],
+    deterministic: true,
+  },
+  layout: state.layout,
+  inventory: state.inventory,
+};
+
+process.stdout.write(`${JSON.stringify(payload)}\n`);
+
+function parseArgs(argv: readonly string[]): ProbeArgs {
+  const values = new Map<string, string>();
+  const normalizedArgv = argv.filter((arg) => arg !== "--");
+
+  for (let index = 0; index < normalizedArgv.length; index += 1) {
+    const arg = normalizedArgv[index];
+    if (!arg.startsWith("--")) {
+      throw new Error(`Unexpected argument: ${arg}`);
+    }
+
+    const key = arg.slice(2);
+    const value = normalizedArgv[index + 1];
+    if (value === undefined || value.startsWith("--")) {
+      throw new Error(`Missing value for --${key}`);
+    }
+
+    values.set(key, value);
+    index += 1;
+  }
+
+  const increment = values.get("increment");
+  const scenario = values.get("scenario");
+  const format = values.get("format");
+
+  if (increment === undefined) {
+    throw new Error("Missing required argument: --increment");
+  }
+
+  if (scenario === undefined) {
+    throw new Error("Missing required argument: --scenario");
+  }
+
+  if (format !== "json") {
+    throw new Error("Only --format json is supported.");
+  }
+
+  return { increment, scenario, format };
+}
diff --git a/src/domain/inventory.ts b/src/domain/inventory.ts
new file mode 100644
index 0000000..2a30d95
--- /dev/null
+++ b/src/domain/inventory.ts
@@ -0,0 +1,198 @@
+import { assertKnownBin, type BinId, type Layout } from "./layout.js";
+
+export type SkuId = string;
+
+export interface Sku {
+  readonly id: SkuId;
+  readonly description: string;
+}
+
+export interface StockLine {
+  readonly binId: BinId;
+  readonly skuId: SkuId;
+  readonly quantity: number;
+}
+
+export interface Inventory {
+  readonly skus: readonly Sku[];
+  readonly stock: readonly StockLine[];
+}
+
+export interface StockMovement {
+  readonly binId: BinId;
+  readonly skuId: SkuId;
+  readonly quantity: number;
+}
+
+export interface TransferMovement {
+  readonly fromBinId: BinId;
+  readonly toBinId: BinId;
+  readonly skuId: SkuId;
+  readonly quantity: number;
+}
+
+export function createInventory(skus: readonly Sku[], stock: readonly StockLine[], layout: Layout): Inventory {
+  const skuIds = new Set<string>();
+
+  for (const sku of skus) {
+    if (!sku.id) {
+      throw new Error("SKU id is required.");
+    }
+
+    if (skuIds.has(sku.id)) {
+      throw new Error(`Duplicate SKU id: ${sku.id}`);
+    }
+
+    skuIds.add(sku.id);
+  }
+
+  for (const line of stock) {
+    assertKnownBin(layout, line.binId);
+    assertKnownSku(skuIds, line.skuId);
+    assertNonNegativeQuantity(line.quantity);
+  }
+
+  return normalizeInventory({
+    skus: skus.map((sku) => ({ ...sku })),
+    stock: stock.map((line) => ({ ...line })),
+  });
+}
+
+export function receiveStock(inventory: Inventory, layout: Layout, movement: StockMovement): Inventory {
+  validateMovement(inventory, layout, movement);
+
+  return applyQuantityDelta(inventory, movement.binId, movement.skuId, movement.quantity);
+}
+
+export function ingressStock(inventory: Inventory, layout: Layout, movement: StockMovement): Inventory {
+  return receiveStock(inventory, layout, movement);
+}
+
+export function withdrawStock(inventory: Inventory, layout: Layout, movement: StockMovement): Inventory {
+  validateMovement(inventory, layout, movement);
+
+  const available = getStockQuantity(inventory, movement.binId, movement.skuId);
+  if (available < movement.quantity) {
+    throw new Error(
+      `Insufficient stock for SKU ${movement.skuId} in bin ${movement.binId}: requested ${movement.quantity}, available ${available}.`,
+    );
+  }
+
+  return applyQuantityDelta(inventory, movement.binId, movement.skuId, -movement.quantity);
+}
+
+export function transferStock(inventory: Inventory, layout: Layout, movement: TransferMovement): Inventory {
+  assertPositiveQuantity(movement.quantity);
+  assertKnownBin(layout, movement.fromBinId);
+  assertKnownBin(layout, movement.toBinId);
+  assertKnownSku(new Set(inventory.skus.map((sku) => sku.id)), movement.skuId);
+
+  if (movement.fromBinId === movement.toBinId) {
+    return normalizeInventory(inventory);
+  }
+
+  const sourceQuantity = getStockQuantity(inventory, movement.fromBinId, movement.skuId);
+  if (sourceQuantity < movement.quantity) {
+    throw new Error(
+      `Insufficient stock for SKU ${movement.skuId} in bin ${movement.fromBinId}: requested ${movement.quantity}, available ${sourceQuantity}.`,
+    );
+  }
+
+  return applyQuantityDelta(
+    applyQuantityDelta(inventory, movement.fromBinId, movement.skuId, -movement.quantity),
+    movement.toBinId,
+    movement.skuId,
+    movement.quantity,
+  );
+}
+
+export function getStockQuantity(inventory: Inventory, binId: BinId, skuId: SkuId): number {
+  return inventory.stock.find((line) => line.binId === binId && line.skuId === skuId)?.quantity ?? 0;
+}
+
+export function totalQuantity(inventory: Inventory, skuId?: SkuId): number {
+  return inventory.stock
+    .filter((line) => skuId === undefined || line.skuId === skuId)
+    .reduce((total, line) => total + line.quantity, 0);
+}
+
+function validateMovement(inventory: Inventory, layout: Layout, movement: StockMovement): void {
+  assertPositiveQuantity(movement.quantity);
+  assertKnownBin(layout, movement.binId);
+  assertKnownSku(new Set(inventory.skus.map((sku) => sku.id)), movement.skuId);
+}
+
+function applyQuantityDelta(inventory: Inventory, binId: BinId, skuId: SkuId, delta: number): Inventory {
+  const stockByKey = new Map<string, StockLine>();
+
+  for (const line of inventory.stock) {
+    stockByKey.set(stockKey(line.binId, line.skuId), { ...line });
+  }
+
+  const key = stockKey(binId, skuId);
+  const current = stockByKey.get(key)?.quantity ?? 0;
+  const nextQuantity = current + delta;
+
+  if (nextQuantity < 0) {
+    throw new Error(`Stock cannot be negative for SKU ${skuId} in bin ${binId}.`);
+  }
+
+  if (nextQuantity === 0) {
+    stockByKey.delete(key);
+  } else {
+    stockByKey.set(key, { binId, skuId, quantity: nextQuantity });
+  }
+
+  return normalizeInventory({
+    skus: inventory.skus.map((sku) => ({ ...sku })),
+    stock: [...stockByKey.values()],
+  });
+}
+
+function normalizeInventory(inventory: Inventory): Inventory {
+  const stockByKey = new Map<string, StockLine>();
+
+  for (const line of inventory.stock) {
+    const key = stockKey(line.binId, line.skuId);
+    const currentQuantity = stockByKey.get(key)?.quantity ?? 0;
+    const quantity = currentQuantity + line.quantity;
+
+    if (quantity === 0) {
+      stockByKey.delete(key);
+    } else {
+      stockByKey.set(key, { binId: line.binId, skuId: line.skuId, quantity });
+    }
+  }
+
+  return {
+    skus: [...inventory.skus].sort((left, right) => left.id.localeCompare(right.id)).map((sku) => ({ ...sku })),
+    stock: [...stockByKey.values()]
+      .sort((left, right) => {
+        const byBin = left.binId.localeCompare(right.binId);
+        return byBin === 0 ? left.skuId.localeCompare(right.skuId) : byBin;
+      })
+      .map((line) => ({ ...line })),
+  };
+}
+
+function assertKnownSku(skuIds: Set<string>, skuId: SkuId): void {
+  if (!skuIds.has(skuId)) {
+    throw new Error(`Unknown SKU: ${skuId}`);
+  }
+}
+
+function assertPositiveQuantity(quantity: number): void {
+  if (!Number.isInteger(quantity) || quantity <= 0) {
+    throw new Error(`Quantity must be a positive integer: ${quantity}`);
+  }
+}
+
+function assertNonNegativeQuantity(quantity: number): void {
+  if (!Number.isInteger(quantity) || quantity < 0) {
+    throw new Error(`Quantity must be a non-negative integer: ${quantity}`);
+  }
+}
+
+function stockKey(binId: BinId, skuId: SkuId): string {
+  return `${binId}\u0000${skuId}`;
+}
