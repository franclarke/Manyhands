+++ b/src/domain/warehouse.test.ts
@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  createWarehouseState,
+  getStockQuantity,
+  receiveStock,
+  totalStockBySku,
+  transferStock,
+  withdrawStock,
+  type WarehouseLayout,
+} from "./warehouse.ts";
+
+const layout: WarehouseLayout = {
+  zones: [
+    { id: "receiving", name: "Receiving" },
+    { id: "picking", name: "Picking" },
+  ],
+  bins: [
+    { id: "RCV-01", zoneId: "receiving", label: "Receiving 01" },
+    { id: "PCK-01", zoneId: "picking", label: "Picking 01" },
+  ],
+};
+
+const skus = [{ id: "SKU-A", name: "Aerosol valve kit" }];
+
+test("receiving, withdrawing, and transferring stock preserve expected quantities", () => {
+  const initial = createWarehouseState(layout, skus, [
+    { binId: "RCV-01", skuId: "SKU-A", quantity: 10 },
+    { binId: "PCK-01", skuId: "SKU-A", quantity: 3 },
+  ]);
+
+  const afterReceive = receiveStock(initial, { binId: "RCV-01", skuId: "SKU-A", quantity: 5 });
+  assert.equal(totalStockBySku(afterReceive, "SKU-A"), 18);
+  assert.equal(getStockQuantity(afterReceive, "RCV-01", "SKU-A"), 15);
+  assert.equal(totalStockBySku(initial, "SKU-A"), 13);
+
+  const afterWithdraw = withdrawStock(afterReceive, { binId: "PCK-01", skuId: "SKU-A", quantity: 2 });
+  assert.equal(totalStockBySku(afterWithdraw, "SKU-A"), 16);
+  assert.equal(getStockQuantity(afterWithdraw, "PCK-01", "SKU-A"), 1);
+
+  const afterTransfer = transferStock(afterWithdraw, {
+    fromBinId: "RCV-01",
+    toBinId: "PCK-01",
+    skuId: "SKU-A",
+    quantity: 6,
+  });
+  assert.equal(totalStockBySku(afterTransfer, "SKU-A"), 16);
+  assert.equal(getStockQuantity(afterTransfer, "RCV-01", "SKU-A"), 9);
+  assert.equal(getStockQuantity(afterTransfer, "PCK-01", "SKU-A"), 7);
+});
+
+test("operations reject negative stock, invalid quantities, and unknown bins", () => {
+  const state = createWarehouseState(layout, skus, [
+    { binId: "RCV-01", skuId: "SKU-A", quantity: 4 },
+  ]);
+
+  assert.throws(
+    () => withdrawStock(state, { binId: "RCV-01", skuId: "SKU-A", quantity: 5 }),
+    /current stock is 4/,
+  );
+  assert.throws(
+    () => transferStock(state, { fromBinId: "RCV-01", toBinId: "PCK-01", skuId: "SKU-A", quantity: 5 }),
+    /current stock is 4/,
+  );
+  assert.throws(
+    () => receiveStock(state, { binId: "UNKNOWN", skuId: "SKU-A", quantity: 1 }),
+    /Unknown bin: UNKNOWN/,
+  );
+  assert.throws(
+    () => withdrawStock(state, { binId: "UNKNOWN", skuId: "SKU-A", quantity: 1 }),
+    /Unknown bin: UNKNOWN/,
+  );
+  assert.throws(
+    () => transferStock(state, { fromBinId: "RCV-01", toBinId: "UNKNOWN", skuId: "SKU-A", quantity: 1 }),
+    /Unknown bin: UNKNOWN/,
+  );
+  assert.throws(
+    () => receiveStock(state, { binId: "RCV-01", skuId: "SKU-A", quantity: 0 }),
+    /positive integer/,
+  );
+  assert.throws(
+    () => createWarehouseState(layout, skus, [{ binId: "RCV-01", skuId: "SKU-A", quantity: -1 }]),
+    /non-negative integer/,
+  );
+});
diff --git a/src/domain/warehouse.ts b/src/domain/warehouse.ts
new file mode 100644
index 0000000..7faa68d
--- /dev/null
+++ b/src/domain/warehouse.ts
@@ -0,0 +1,290 @@
+export type Zone = {
+  id: string;
+  name: string;
+};
+
+export type Bin = {
+  id: string;
+  zoneId: string;
+  label: string;
+};
+
+export type Sku = {
+  id: string;
+  name: string;
+};
+
+export type WarehouseLayout = {
+  zones: readonly Zone[];
+  bins: readonly Bin[];
+};
+
+export type InventoryEntry = {
+  binId: string;
+  skuId: string;
+  quantity: number;
+};
+
+export type WarehouseState = {
+  layout: WarehouseLayout;
+  skus: readonly Sku[];
+  inventory: readonly InventoryEntry[];
+};
+
+export type StockOperation = {
+  binId: string;
+  skuId: string;
+  quantity: number;
+};
+
+export type TransferOperation = {
+  fromBinId: string;
+  toBinId: string;
+  skuId: string;
+  quantity: number;
+};
+
+type StockKey = `${string}\u0000${string}`;
+
+const STOCK_KEY_SEPARATOR = "\u0000";
+
+export function createWarehouseState(
+  layout: WarehouseLayout,
+  skus: readonly Sku[],
+  inventory: readonly InventoryEntry[],
+): WarehouseState {
+  validateLayout(layout);
+  validateUniqueIds("sku", skus.map((sku) => sku.id));
+
+  const binIds = new Set(layout.bins.map((bin) => bin.id));
+  const skuIds = new Set(skus.map((sku) => sku.id));
+  const stock = new Map<StockKey, number>();
+
+  for (const entry of inventory) {
+    assertKnownId("bin", entry.binId, binIds);
+    assertKnownId("sku", entry.skuId, skuIds);
+    assertNonNegativeInteger("stock quantity", entry.quantity);
+
+    if (entry.quantity === 0) {
+      continue;
+    }
+
+    const key = stockKey(entry.binId, entry.skuId);
+    stock.set(key, (stock.get(key) ?? 0) + entry.quantity);
+  }
+
+  return {
+    layout: {
+      zones: sortById(layout.zones),
+      bins: sortById(layout.bins),
+    },
+    skus: sortById(skus),
+    inventory: stockEntriesFromMap(stock),
+  };
+}
+
+export function receiveStock(state: WarehouseState, operation: StockOperation): WarehouseState {
+  validateOperationTarget(state, operation.binId, operation.skuId);
+  assertPositiveInteger("received quantity", operation.quantity);
+
+  const stock = stockMapFromState(state);
+  const key = stockKey(operation.binId, operation.skuId);
+  stock.set(key, (stock.get(key) ?? 0) + operation.quantity);
+
+  return replaceInventory(state, stock);
+}
+
+export function withdrawStock(state: WarehouseState, operation: StockOperation): WarehouseState {
+  validateOperationTarget(state, operation.binId, operation.skuId);
+  assertPositiveInteger("withdrawn quantity", operation.quantity);
+
+  const stock = stockMapFromState(state);
+  const key = stockKey(operation.binId, operation.skuId);
+  const currentQuantity = stock.get(key) ?? 0;
+  const nextQuantity = currentQuantity - operation.quantity;
+
+  if (nextQuantity < 0) {
+    throw new Error(
+      `Cannot withdraw ${operation.quantity} units of ${operation.skuId} from ${operation.binId}; current stock is ${currentQuantity}.`,
+    );
+  }
+
+  setStockQuantity(stock, key, nextQuantity);
+  return replaceInventory(state, stock);
+}
+
+export function transferStock(state: WarehouseState, operation: TransferOperation): WarehouseState {
+  validateOperationTarget(state, operation.fromBinId, operation.skuId);
+  validateOperationTarget(state, operation.toBinId, operation.skuId);
+  assertPositiveInteger("transferred quantity", operation.quantity);
+
+  if (operation.fromBinId === operation.toBinId) {
+    return state;
+  }
+
+  const stock = stockMapFromState(state);
+  const fromKey = stockKey(operation.fromBinId, operation.skuId);
+  const toKey = stockKey(operation.toBinId, operation.skuId);
+  const currentQuantity = stock.get(fromKey) ?? 0;
+  const nextFromQuantity = currentQuantity - operation.quantity;
+
+  if (nextFromQuantity < 0) {
+    throw new Error(
+      `Cannot transfer ${operation.quantity} units of ${operation.skuId} from ${operation.fromBinId}; current stock is ${currentQuantity}.`,
+    );
+  }
+
+  setStockQuantity(stock, fromKey, nextFromQuantity);
+  stock.set(toKey, (stock.get(toKey) ?? 0) + operation.quantity);
+
+  return replaceInventory(state, stock);
+}
+
+export function getStockQuantity(state: WarehouseState, binId: string, skuId: string): number {
+  validateOperationTarget(state, binId, skuId);
+  return stockMapFromState(state).get(stockKey(binId, skuId)) ?? 0;
+}
+
+export function totalStockBySku(state: WarehouseState, skuId: string): number {
+  assertKnownId("sku", skuId, new Set(state.skus.map((sku) => sku.id)));
+
+  return state.inventory
+    .filter((entry) => entry.skuId === skuId)
+    .reduce((total, entry) => total + entry.quantity, 0);
+}
+
+export function warehouseStateHash(state: WarehouseState): string {
+  return fnv1a64(stableJsonStringify(canonicalWarehouseState(state)));
+}
+
+export function canonicalWarehouseState(state: WarehouseState): WarehouseState {
+  return createWarehouseState(state.layout, state.skus, state.inventory);
+}
+
+export function stableJsonStringify(value: unknown): string {
+  if (value === null || typeof value !== "object") {
+    return JSON.stringify(value);
+  }
+
+  if (Array.isArray(value)) {
+    return `[${value.map((item) => stableJsonStringify(item)).join(",")}]`;
+  }
+
+  const record = value as Record<string, unknown>;
+  const properties = Object.keys(record)
+    .sort()
+    .map((key) => `${JSON.stringify(key)}:${stableJsonStringify(record[key])}`);
+
+  return `{${properties.join(",")}}`;
+}
+
+function validateLayout(layout: WarehouseLayout): void {
+  validateUniqueIds("zone", layout.zones.map((zone) => zone.id));
+  validateUniqueIds("bin", layout.bins.map((bin) => bin.id));
+
+  const zoneIds = new Set(layout.zones.map((zone) => zone.id));
+
+  for (const bin of layout.bins) {
+    assertKnownId("zone", bin.zoneId, zoneIds);
+  }
+}
+
+function validateUniqueIds(kind: string, ids: readonly string[]): void {
+  const seen = new Set<string>();
+
+  for (const id of ids) {
+    if (id.trim() === "") {
+      throw new Error(`${kind} id cannot be empty.`);
+    }
+
+    if (seen.has(id)) {
+      throw new Error(`Duplicate ${kind} id: ${id}.`);
+    }
+
+    seen.add(id);
+  }
+}
+
+function validateOperationTarget(state: WarehouseState, binId: string, skuId: string): void {
+  assertKnownId("bin", binId, new Set(state.layout.bins.map((bin) => bin.id)));
+  assertKnownId("sku", skuId, new Set(state.skus.map((sku) => sku.id)));
+}
+
+function assertKnownId(kind: string, id: string, knownIds: ReadonlySet<string>): void {
+  if (!knownIds.has(id)) {
+    throw new Error(`Unknown ${kind}: ${id}.`);
+  }
+}
+
+function assertPositiveInteger(label: string, value: number): void {
+  if (!Number.isInteger(value) || value <= 0) {
+    throw new Error(`${label} must be a positive integer.`);
+  }
+}
+
+function assertNonNegativeInteger(label: string, value: number): void {
+  if (!Number.isInteger(value) || value < 0) {
+    throw new Error(`${label} must be a non-negative integer.`);
+  }
+}
+
+function stockMapFromState(state: WarehouseState): Map<StockKey, number> {
+  const stock = new Map<StockKey, number>();
+
+  for (const entry of state.inventory) {
+    stock.set(stockKey(entry.binId, entry.skuId), entry.quantity);
+  }
+
+  return stock;
+}
+
+function stockEntriesFromMap(stock: ReadonlyMap<StockKey, number>): InventoryEntry[] {
+  return Array.from(stock.entries())
+    .filter(([, quantity]) => quantity > 0)
+    .map(([key, quantity]) => {
+      const [binId, skuId] = key.split(STOCK_KEY_SEPARATOR);
+      return { binId, skuId, quantity };
+    })
+    .sort(compareInventoryEntries);
+}
+
+function replaceInventory(state: WarehouseState, stock: ReadonlyMap<StockKey, number>): WarehouseState {
+  return {
+    ...state,
+    inventory: stockEntriesFromMap(stock),
+  };
+}
+
+function setStockQuantity(stock: Map<StockKey, number>, key: StockKey, quantity: number): void {
+  if (quantity === 0) {
+    stock.delete(key);
+    return;
+  }
+
+  stock.set(key, quantity);
+}
+
+function stockKey(binId: string, skuId: string): StockKey {
+  return `${binId}${STOCK_KEY_SEPARATOR}${skuId}`;
+}
+
+function sortById<T extends { id: string }>(items: readonly T[]): T[] {
+  return [...items].sort((left, right) => left.id.localeCompare(right.id));
+}
+
+function compareInventoryEntries(left: InventoryEntry, right: InventoryEntry): number {
+  return left.binId.localeCompare(right.binId) || left.skuId.localeCompare(right.skuId);
+}
+
+function fnv1a64(input: string): string {
+  let hash = 0xcbf29ce484222325n;
+  const prime = 0x100000001b3n;
+  const mask = 0xffffffffffffffffn;
+
+  for (let index = 0; index < input.length; index += 1) {
+    hash ^= BigInt(input.charCodeAt(index));
+    hash = (hash * prime) & mask;
+  }
+
+  return hash.toString(16).padStart(16, "0");
+}
