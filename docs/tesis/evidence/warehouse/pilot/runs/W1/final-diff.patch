@@ -0,0 +1,37 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { warehouseStateHash } from "../domain/warehouse.ts";
+import { createThesisSeed2026Warehouse } from "../scenarios/thesis-seed-2026.ts";
+import { runStudyProbe } from "./probe.ts";
+import type { W1ProbeOutput } from "./probe-output.ts";
+
+test("W1 thesis-seed-2026 probe emits schema 1 JSON from the productive domain state", () => {
+  const json = runStudyProbe("W1", "thesis-seed-2026");
+  const output = JSON.parse(json) as W1ProbeOutput;
+  const state = createThesisSeed2026Warehouse();
+
+  assert.equal(output.schema, 1);
+  assert.equal(output.phase, "W1");
+  assert.equal(output.scenarioId, "thesis-seed-2026");
+  assert.equal(output.stateHash, warehouseStateHash(state));
+  assert.deepEqual(output.layout, state.layout);
+  assert.deepEqual(output.inventory, {
+    skus: state.skus,
+    stock: state.inventory,
+  });
+});
+
+test("W1 probe JSON bytes are deterministic for the same seed", () => {
+  const first = runStudyProbe("W1", "thesis-seed-2026");
+  const second = runStudyProbe("W1", "thesis-seed-2026");
+
+  assert.equal(first, second);
+});
+
+test("W1 probe rejects unsupported scenarios", () => {
+  assert.throws(
+    () => runStudyProbe("W1", "unknown" as "thesis-seed-2026"),
+    /Unsupported scenario: unknown/,
+  );
+});
diff --git a/src/study/probe.ts b/src/study/probe.ts
new file mode 100644
index 0000000..4730330
--- /dev/null
+++ b/src/study/probe.ts
@@ -0,0 +1,17 @@
+import { createThesisSeed2026Warehouse, THESIS_SEED_2026_SCENARIO_ID } from "../scenarios/thesis-seed-2026.ts";
+import { buildW1ProbeOutput, renderProbeOutputJson } from "./probe-output.ts";
+
+export type StudyPhase = "W1";
+export type StudyScenarioId = typeof THESIS_SEED_2026_SCENARIO_ID;
+
+export function runStudyProbe(phase: StudyPhase, scenarioId: StudyScenarioId): string {
+  if (phase !== "W1") {
+    throw new Error(`Unsupported study phase: ${phase}.`);
+  }
+
+  if (scenarioId !== THESIS_SEED_2026_SCENARIO_ID) {
+    throw new Error(`Unsupported scenario: ${scenarioId}.`);
+  }
+
+  return renderProbeOutputJson(buildW1ProbeOutput(createThesisSeed2026Warehouse()));
+}
