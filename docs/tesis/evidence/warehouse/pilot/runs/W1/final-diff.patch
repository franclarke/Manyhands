+import {
+  canonicalWarehouseState,
+  stableJsonStringify,
+  warehouseStateHash,
+  type WarehouseState,
+} from "../domain/warehouse.ts";
+
+export type ProbeLayout = {
+  zones: WarehouseState["layout"]["zones"];
+  bins: WarehouseState["layout"]["bins"];
+};
+
+export type ProbeInventory = {
+  skus: WarehouseState["skus"];
+  stock: WarehouseState["inventory"];
+};
+
+export type W1ProbeOutput = {
+  schema: 1;
+  phase: "W1";
+  scenarioId: "thesis-seed-2026";
+  stateHash: string;
+  layout: ProbeLayout;
+  inventory: ProbeInventory;
+};
+
+export function buildW1ProbeOutput(state: WarehouseState): W1ProbeOutput {
+  const canonicalState = canonicalWarehouseState(state);
+
+  return {
+    schema: 1,
+    phase: "W1",
+    scenarioId: "thesis-seed-2026",
+    stateHash: warehouseStateHash(canonicalState),
+    layout: canonicalState.layout,
+    inventory: {
+      skus: canonicalState.skus,
+      stock: canonicalState.inventory,
+    },
+  };
+}
+
+export function renderProbeOutputJson(output: W1ProbeOutput): string {
+  return `${stableJsonStringify(output)}\n`;
+}
diff --git a/src/study/probe.test.ts b/src/study/probe.test.ts
