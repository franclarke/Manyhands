+import { createWarehouseState, type WarehouseState } from "../domain/warehouse.ts";
+
+export const THESIS_SEED_2026_SCENARIO_ID = "thesis-seed-2026";
+
+export function createThesisSeed2026Warehouse(): WarehouseState {
+  return createWarehouseState(
+    {
+      zones: [
+        { id: "bulk-storage", name: "Bulk Storage" },
+        { id: "forward-pick", name: "Forward Pick" },
+        { id: "receiving", name: "Receiving" },
+      ],
+      bins: [
+        { id: "BULK-01", zoneId: "bulk-storage", label: "Bulk aisle 1 bay 1" },
+        { id: "BULK-02", zoneId: "bulk-storage", label: "Bulk aisle 1 bay 2" },
+        { id: "BULK-03", zoneId: "bulk-storage", label: "Bulk aisle 2 bay 1" },
+        { id: "BULK-04", zoneId: "bulk-storage", label: "Bulk aisle 2 bay 2" },
+        { id: "PICK-01", zoneId: "forward-pick", label: "Pick face 1" },
+        { id: "PICK-02", zoneId: "forward-pick", label: "Pick face 2" },
+        { id: "PICK-03", zoneId: "forward-pick", label: "Pick face 3" },
+        { id: "PICK-04", zoneId: "forward-pick", label: "Pick face 4" },
+        { id: "RCV-01", zoneId: "receiving", label: "Inbound dock 1" },
+        { id: "RCV-02", zoneId: "receiving", label: "Inbound dock 2" },
+        { id: "RCV-03", zoneId: "receiving", label: "Inbound staging 1" },
+        { id: "RCV-04", zoneId: "receiving", label: "Inbound staging 2" },
+      ],
+    },
+    [
+      { id: "SKU-AR-001", name: "Sensor node kit" },
+      { id: "SKU-AR-002", name: "Router replacement pack" },
+      { id: "SKU-AR-003", name: "Barcode label roll" },
+    ],
+    [
+      { binId: "BULK-01", skuId: "SKU-AR-001", quantity: 48 },
+      { binId: "PICK-01", skuId: "SKU-AR-001", quantity: 12 },
+      { binId: "RCV-01", skuId: "SKU-AR-001", quantity: 8 },
+      { binId: "BULK-02", skuId: "SKU-AR-002", quantity: 36 },
+      { binId: "PICK-02", skuId: "SKU-AR-002", quantity: 9 },
+      { binId: "RCV-02", skuId: "SKU-AR-002", quantity: 6 },
+      { binId: "BULK-03", skuId: "SKU-AR-003", quantity: 120 },
+      { binId: "PICK-03", skuId: "SKU-AR-003", quantity: 30 },
+      { binId: "RCV-03", skuId: "SKU-AR-003", quantity: 15 },
+    ],
+  );
+}
