+  type AssertionErrorExpectation = RegExp | ((error: unknown) => boolean) | object;
+
+  const assert: {
+    equal(actual: unknown, expected: unknown, message?: string): void;
+    deepEqual(actual: unknown, expected: unknown, message?: string): void;
+    ok(value: unknown, message?: string): void;
+    throws(block: () => unknown, expected?: AssertionErrorExpectation, message?: string): void;
+  };
+
+  export default assert;
+}
+
+declare module "node:test" {
+  export default function test(name: string, callback: () => void): void;
+}
