+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { totalStockBySku, stableJsonStringify } from "../domain/warehouse.ts";
+import { createThesisSeed2026Warehouse, THESIS_SEED_2026_SCENARIO_ID } from "./thesis-seed-2026.ts";
+
+test("thesis-seed-2026 contains the required productive warehouse baseline", () => {
+  const state = createThesisSeed2026Warehouse();
+
+  assert.equal(THESIS_SEED_2026_SCENARIO_ID, "thesis-seed-2026");
+  assert.ok(state.layout.zones.length >= 3);
+  assert.ok(state.layout.bins.length >= 12);
+  assert.ok(state.skus.length >= 3);
+
+  for (const sku of state.skus) {
+    assert.ok(totalStockBySku(state, sku.id) > 0, `${sku.id} should have positive stock`);
+  }
+});
+
+test("thesis-seed-2026 is deterministic across repeated construction", () => {
+  const first = stableJsonStringify(createThesisSeed2026Warehouse());
+  const second = stableJsonStringify(createThesisSeed2026Warehouse());
+
+  assert.equal(first, second);
+});
