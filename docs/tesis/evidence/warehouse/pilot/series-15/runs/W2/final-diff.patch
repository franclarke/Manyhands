@@ -94,3 +97,31 @@ export function totalUnits(state: InventoryState): number {
   }
   return total;
 }
+
+export function inventoryLines(state: InventoryState): InventoryLine[] {
+  const lines: InventoryLine[] = [];
+  for (const [key, quantity] of state.quantities.entries()) {
+    const separatorIndex = key.indexOf("::");
+    if (separatorIndex > 0 && quantity > 0) {
+      lines.push({
+        binId: key.slice(0, separatorIndex),
+        skuId: key.slice(separatorIndex + 2),
+        quantity,
+      });
+    }
+  }
+  return lines.sort((a, b) => {
+    if (a.binId !== b.binId) return a.binId < b.binId ? -1 : 1;
+    return a.skuId < b.skuId ? -1 : a.skuId > b.skuId ? 1 : 0;
+  });
+}
+
+export function binSkuQuantities(state: InventoryState, binId: string): InventoryLine[] {
+  assertKnownBin(state, binId);
+  return inventoryLines(state).filter((line) => line.binId === binId);
+}
+
+export function binTotalUnits(state: InventoryState, binId: string): number {
+  assertKnownBin(state, binId);
+  return binSkuQuantities(state, binId).reduce((sum, line) => sum + line.quantity, 0);
+}
