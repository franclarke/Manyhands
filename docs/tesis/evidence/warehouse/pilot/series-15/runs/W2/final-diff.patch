@@ -0,0 +1,28 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildControlTowerVisual } from "../domain/visual.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+
+test("control tower visual model provides selectable bin details for the UI", () => {
+  const scenario = buildThesisSeed2026();
+  const visual = buildControlTowerVisual(scenario.layout, scenario.inventory);
+  const selected = visual.heatmapCells.find((cell) => cell.quantity > 0);
+
+  if (selected === undefined) {
+    throw new Error("expected at least one stocked bin");
+  }
+  assert.ok(selected.skuLines.length >= 1);
+  assert.ok(selected.quantity >= 1);
+  assert.ok(selected.capacity >= selected.quantity);
+  assert.ok(["critical", "normal", "full"].includes(selected.status));
+});
+
+test("control tower visual exposes zones, aisles, cells, and labels for SVG rendering", () => {
+  const scenario = buildThesisSeed2026();
+  const visual = buildControlTowerVisual(scenario.layout, scenario.inventory);
+
+  assert.equal(visual.zones.length, scenario.layout.zones.length);
+  assert.equal(visual.aisles.length, scenario.layout.aisles.length);
+  assert.equal(visual.heatmapCells.length, scenario.layout.bins.length);
+  assert.ok(visual.textLabels.some((label) => label.kind === "legend"));
+});
