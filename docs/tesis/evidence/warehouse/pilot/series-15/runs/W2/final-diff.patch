diff --git a/src/ui/App.tsx b/src/ui/App.tsx
new file mode 100644
index 0000000..32e08c1
--- /dev/null
+++ b/src/ui/App.tsx
@@ -0,0 +1,184 @@
+import { useMemo, useState, type KeyboardEvent } from "react";
+import { buildControlTowerVisual, type BinVisualStatus, type HeatmapCell } from "../domain/visual.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+
+const STATUS_CLASS: Record<BinVisualStatus, string> = {
+  empty: "status-empty",
+  critical: "status-critical",
+  normal: "status-normal",
+  full: "status-full",
+};
+
+const STATUS_LABEL: Record<BinVisualStatus, string> = {
+  empty: "Empty",
+  critical: "Critical stock",
+  normal: "Nominal",
+  full: "Near full",
+};
+
+function occupancyPercent(cell: HeatmapCell): number {
+  return Math.round(cell.occupancyRatio * 100);
+}
+
+function firstActionableCell(cells: readonly HeatmapCell[]): HeatmapCell {
+  return cells.find((cell) => cell.status === "critical") ?? cells[0]!;
+}
+
+interface HeatmapProps {
+  readonly cells: readonly HeatmapCell[];
+  readonly selectedBinId: string;
+  readonly onSelect: (binId: string) => void;
+}
+
+function WarehouseHeatmap({ cells, selectedBinId, onSelect }: HeatmapProps) {
+  const scenario = useMemo(() => buildThesisSeed2026(), []);
+  const visual = useMemo(() => buildControlTowerVisual(scenario.layout, scenario.inventory), [scenario]);
+
+  const handleKeyDown = (event: KeyboardEvent<SVGGElement>, binId: string) => {
+    if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault();
+      onSelect(binId);
+    }
+  };
+
+  return (
+    <svg
+      className="warehouse-map"
+      role="img"
+      aria-labelledby="warehouse-map-title warehouse-map-desc"
+      viewBox={`${visual.viewBox.x} ${visual.viewBox.y} ${visual.viewBox.width} ${visual.viewBox.height}`}
+    >
+      <title id="warehouse-map-title">W1 warehouse layout heatmap</title>
+      <desc id="warehouse-map-desc">
+        Zones, aisles, and one interactive heatmap cell for each scenario bin. Text labels show
+        occupancy and critical stock status.
+      </desc>
+
+      {visual.zones.map((zone) => (
+        <g key={zone.id}>
+          <rect className="zone-panel" {...zone.rect} rx="6" />
+        </g>
+      ))}
+
+      {visual.aisles.map((aisle) => (
+        <rect key={aisle.id} className="aisle" {...aisle.rect} rx="3" />
+      ))}
+
+      {cells.map((cell) => {
+        const isSelected = cell.binId === selectedBinId;
+        return (
+          <g
+            key={cell.binId}
+            className={`bin-cell ${STATUS_CLASS[cell.status]} ${isSelected ? "is-selected" : ""}`}
+            role="button"
+            tabIndex={0}
+            aria-pressed={isSelected}
+            aria-label={`${cell.binCode}, ${cell.zoneName}, ${cell.quantity} of ${cell.capacity} units, ${
+              STATUS_LABEL[cell.status]
+            }`}
+            onClick={() => onSelect(cell.binId)}
+            onKeyDown={(event: KeyboardEvent<SVGGElement>) => handleKeyDown(event, cell.binId)}
+          >
+            <rect {...cell.rect} rx="5" />
+            <text x={cell.rect.x + 7} y={cell.rect.y + 16}>
+              {cell.binCode}
+            </text>
+            <text x={cell.rect.x + 7} y={cell.rect.y + 32}>
+              {cell.quantity}/{cell.capacity} - {occupancyPercent(cell)}%
+            </text>
+          </g>
+        );
+      })}
+
+      {visual.textLabels
+        .filter((label) => label.kind === "zone" || label.kind === "aisle")
+        .map((label) => (
+          <text key={label.id} className={`map-label map-label-${label.kind}`} x={label.x} y={label.y}>
+            {label.text}
+          </text>
+        ))}
+
+      <g className="legend" role="list" aria-label="Heatmap legend">
+        {visual.legend.map((item, index) => (
+          <g key={item.id} role="listitem">
+            <rect className={`legend-swatch ${STATUS_CLASS[item.id]}`} x="24" y={480 + index * 22} width="14" height="14" rx="3" />
+            <text className="map-label map-label-legend" x="46" y={492 + index * 22}>
+              {item.label}: {item.description}
+            </text>
+          </g>
+        ))}
+      </g>
+    </svg>
+  );
+}
+
+export function App() {
+  const scenario = useMemo(() => buildThesisSeed2026(), []);
+  const visual = useMemo(() => buildControlTowerVisual(scenario.layout, scenario.inventory), [scenario]);
+  const [selectedBinId, setSelectedBinId] = useState(() => firstActionableCell(visual.heatmapCells).binId);
+  const selectedCell = visual.heatmapCells.find((cell) => cell.binId === selectedBinId) ?? firstActionableCell(visual.heatmapCells);
+
+  return (
+    <main className="shell">
+      <section className="overview" aria-labelledby="tower-title">
+        <div>
+          <p className="eyebrow">W2 control tower</p>
+          <h1 id="tower-title">Warehouse W1 heatmap</h1>
+        </div>
+        <dl className="metrics" aria-label="Scenario capability counts">
+          <div>
+            <dt>Zones</dt>
+            <dd>{scenario.layout.zones.length}</dd>
+          </div>
+          <div>
+            <dt>Bins</dt>
+            <dd>{visual.counts.heatmapCells}</dd>
+          </div>
+          <div>
+            <dt>Labels</dt>
+            <dd>{visual.counts.textLabels}</dd>
+          </div>
+        </dl>
+      </section>
+
+      <section className="workspace" aria-label="Warehouse control tower workspace">
+        <div className="map-panel">
+          <WarehouseHeatmap cells={visual.heatmapCells} selectedBinId={selectedCell.binId} onSelect={setSelectedBinId} />
+        </div>
+
+        <aside className="details-panel" aria-labelledby="selected-bin-title">
+          <p className={`status-pill ${STATUS_CLASS[selectedCell.status]}`}>{STATUS_LABEL[selectedCell.status]}</p>
+          <h2 id="selected-bin-title">{selectedCell.binCode}</h2>
+          <dl>
+            <div>
+              <dt>Zone</dt>
+              <dd>{selectedCell.zoneName}</dd>
+            </div>
+            <div>
+              <dt>SKU</dt>
+              <dd>
+                {selectedCell.skuLines.length === 0
+                  ? "No stock"
+                  : selectedCell.skuLines.map((line) => `${line.skuId} (${line.quantity})`).join(", ")}
+              </dd>
+            </div>
+            <div>
+              <dt>Quantity</dt>
+              <dd>{selectedCell.quantity} units</dd>
+            </div>
+            <div>
+              <dt>Capacity</dt>
+              <dd>{selectedCell.capacity} units</dd>
+            </div>
+            <div>
+              <dt>Status</dt>
+              <dd>
+                {STATUS_LABEL[selectedCell.status]} - {occupancyPercent(selectedCell)}% occupied
+              </dd>
+            </div>
+          </dl>
+        </aside>
+      </section>
+    </main>
+  );
+}
