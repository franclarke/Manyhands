+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { buildControlTowerVisual, visualCapability } from "./visual.ts";
+
+test("buildControlTowerVisual renders one heatmap cell for every scenario bin", () => {
+  const scenario = buildThesisSeed2026();
+  const visual = buildControlTowerVisual(scenario.layout, scenario.inventory);
+
+  assert.equal(visual.heatmapCells.length, scenario.layout.bins.length);
+  assert.ok(visual.aisles.length >= 1);
+  assert.ok(visual.zones.length >= 3);
+});
+
+test("visual labels expose occupancy and critical stock without relying only on color", () => {
+  const scenario = buildThesisSeed2026();
+  const visual = buildControlTowerVisual(scenario.layout, scenario.inventory);
+
+  assert.ok(visual.textLabels.some((label) => label.text.includes("/")));
+  assert.ok(visual.textLabels.some((label) => label.text.includes("Critical")));
+  assert.ok(visual.heatmapCells.some((cell) => cell.status === "critical"));
+});
+
+test("visualCapability derives probe counts from the visual model", () => {
+  const scenario = buildThesisSeed2026();
+  const visual = buildControlTowerVisual(scenario.layout, scenario.inventory);
+
+  assert.deepEqual(visualCapability(scenario.layout, scenario.inventory), visual.counts);
+  assert.ok(visual.counts.svgElements >= 1);
+  assert.ok(visual.counts.heatmapCells >= 12);
+  assert.ok(visual.counts.textLabels >= 3);
+});
diff --git a/src/domain/visual.ts b/src/domain/visual.ts
new file mode 100644
index 0000000..c5214b1
--- /dev/null
+++ b/src/domain/visual.ts
@@ -0,0 +1,205 @@
+import { binSkuQuantities, binTotalUnits, type InventoryLine, type InventoryState } from "./inventory.ts";
+import { type Aisle, type Layout, type LayoutRect } from "./layout.ts";
+
+export type BinVisualStatus = "empty" | "critical" | "normal" | "full";
+
+export interface VisualTextLabel {
+  readonly id: string;
+  readonly text: string;
+  readonly x: number;
+  readonly y: number;
+  readonly kind: "zone" | "aisle" | "bin" | "metric" | "legend";
+}
+
+export interface HeatmapCell {
+  readonly binId: string;
+  readonly binCode: string;
+  readonly zoneName: string;
+  readonly rect: LayoutRect;
+  readonly quantity: number;
+  readonly capacity: number;
+  readonly occupancyRatio: number;
+  readonly status: BinVisualStatus;
+  readonly skuLines: readonly InventoryLine[];
+}
+
+export interface LegendItem {
+  readonly id: BinVisualStatus;
+  readonly label: string;
+  readonly description: string;
+}
+
+export interface VisualCapability {
+  readonly svgElements: number;
+  readonly heatmapCells: number;
+  readonly textLabels: number;
+}
+
+export interface ControlTowerVisual {
+  readonly viewBox: LayoutRect;
+  readonly zones: readonly {
+    readonly id: string;
+    readonly name: string;
+    readonly rect: LayoutRect;
+  }[];
+  readonly aisles: readonly Aisle[];
+  readonly heatmapCells: readonly HeatmapCell[];
+  readonly textLabels: readonly VisualTextLabel[];
+  readonly legend: readonly LegendItem[];
+  readonly counts: VisualCapability;
+}
+
+const DEFAULT_BIN_CAPACITY = 50;
+const LEGEND: readonly LegendItem[] = [
+  { id: "empty", label: "Empty", description: "0 units" },
+  { id: "critical", label: "Critical", description: "1-25% occupied" },
+  { id: "normal", label: "Normal", description: "26-89% occupied" },
+  { id: "full", label: "Full", description: "90%+ occupied" },
+];
+
+function clampRatio(value: number): number {
+  return Math.max(0, Math.min(1, value));
+}
+
+function statusFor(quantity: number, capacity: number): BinVisualStatus {
+  if (quantity === 0) return "empty";
+  const occupancyRatio = quantity / capacity;
+  if (occupancyRatio <= 0.25) return "critical";
+  if (occupancyRatio >= 0.9) return "full";
+  return "normal";
+}
+
+function fallbackZoneRect(index: number): LayoutRect {
+  const column = index % 2;
+  const row = Math.floor(index / 2);
+  return {
+    x: 24 + column * 340,
+    y: 24 + row * 220,
+    width: 280,
+    height: 160,
+  };
+}
+
+function fallbackBinRect(zoneRect: LayoutRect, indexInZone: number): LayoutRect {
+  const column = indexInZone % 2;
+  const row = Math.floor(indexInZone / 2);
+  return {
+    x: zoneRect.x + 24 + column * 112,
+    y: zoneRect.y + 44 + row * 48,
+    width: 92,
+    height: 34,
+  };
+}
+
+function bounds(rects: readonly LayoutRect[]): LayoutRect {
+  const maxX = Math.max(...rects.map((rect) => rect.x + rect.width), 1);
+  const maxY = Math.max(...rects.map((rect) => rect.y + rect.height), 1);
+  return { x: 0, y: 0, width: maxX + 24, height: maxY + 24 };
+}
+
+export function buildControlTowerVisual(layout: Layout, inventory: InventoryState): ControlTowerVisual {
+  const zoneRects = new Map<string, LayoutRect>();
+  const zones = layout.zones.map((zone, index) => {
+    const rect = zone.rect ?? fallbackZoneRect(index);
+    zoneRects.set(zone.id, rect);
+    return { id: zone.id, name: zone.name, rect };
+  });
+
+  const zoneBinIndexes = new Map<string, number>();
+  const heatmapCells = layout.bins.map((bin) => {
+    const zoneRect = zoneRects.get(bin.zoneId) ?? fallbackZoneRect(0);
+    const indexInZone = zoneBinIndexes.get(bin.zoneId) ?? 0;
+    zoneBinIndexes.set(bin.zoneId, indexInZone + 1);
+
+    const skuLines = binSkuQuantities(inventory, bin.id);
+    const quantity = binTotalUnits(inventory, bin.id);
+    const capacity = bin.capacityUnits ?? DEFAULT_BIN_CAPACITY;
+    const occupancyRatio = clampRatio(quantity / capacity);
+    const zoneName = layout.zones.find((zone) => zone.id === bin.zoneId)?.name ?? bin.zoneId;
+
+    return {
+      binId: bin.id,
+      binCode: bin.code,
+      zoneName,
+      rect: bin.rect ?? fallbackBinRect(zoneRect, indexInZone),
+      quantity,
+      capacity,
+      occupancyRatio,
+      status: statusFor(quantity, capacity),
+      skuLines,
+    };
+  });
+
+  const textLabels: VisualTextLabel[] = [
+    ...zones.map((zone) => ({
+      id: `${zone.id}-label`,
+      text: zone.name,
+      x: zone.rect.x + 12,
+      y: zone.rect.y + 22,
+      kind: "zone" as const,
+    })),
+    ...layout.aisles.map((aisle) => ({
+      id: `${aisle.id}-label`,
+      text: aisle.label,
+      x: aisle.rect.x + 8,
+      y: aisle.rect.y + 20,
+      kind: "aisle" as const,
+    })),
+    ...heatmapCells.flatMap((cell) => [
+      {
+        id: `${cell.binId}-code-label`,
+        text: cell.binCode,
+        x: cell.rect.x + 6,
+        y: cell.rect.y + 14,
+        kind: "bin" as const,
+      },
+      {
+        id: `${cell.binId}-quantity-label`,
+        text: `${cell.quantity}/${cell.capacity}`,
+        x: cell.rect.x + 6,
+        y: cell.rect.y + 29,
+        kind: "metric" as const,
+      },
+    ]),
+    ...LEGEND.map((item, index) => ({
+      id: `legend-${item.id}`,
+      text: `${item.label}: ${item.description}`,
+      x: 24,
+      y: 494 + index * 22,
+      kind: "legend" as const,
+    })),
+  ];
+
+  const viewBox = bounds([
+    ...zones.map((zone) => zone.rect),
+    ...layout.aisles.map((aisle) => aisle.rect),
+    ...heatmapCells.map((cell) => cell.rect),
+    { x: 0, y: 470, width: 720, height: 110 },
+  ]);
+
+  const counts = {
+    svgElements:
+      1 +
+      zones.length +
+      layout.aisles.length +
+      heatmapCells.length +
+      textLabels.length +
+      LEGEND.length,
+    heatmapCells: heatmapCells.length,
+    textLabels: textLabels.length,
+  };
+
+  return {
+    viewBox,
+    zones,
+    aisles: layout.aisles,
+    heatmapCells,
+    textLabels,
+    legend: LEGEND,
+    counts,
+  };
+}
+
+export function visualCapability(layout: Layout, inventory: InventoryState): VisualCapability {
+  return buildControlTowerVisual(layout, inventory).counts;
+}
