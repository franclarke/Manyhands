+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ingreso, totalUnits, countSkus } from "../domain/inventory.ts";
+import { countBins, countZones } from "../domain/layout.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection04 } from "./projection-04.ts";
+
+test("projection-04 exposes its contract id", () => {
+  assert.equal(projection04.id, "projection-04");
+});
+
+test("projection-04 derives result fields from the W1 scenario inventory", () => {
+  const scenario = buildThesisSeed2026();
+  const result = projection04.project(scenario);
+
+  assert.equal(result.projectionId, `${scenario.name}:${projection04.id}`);
+  assert.equal(result.id, projection04.id);
+  assert.equal(result.scenario, scenario.name);
+  assert.equal(result.metric, "zone-coverage");
+  assert.equal(result.value, countZones(scenario.layout));
+  assert.equal(result.zoneCount, countZones(scenario.layout));
+  assert.equal(result.binCount, countBins(scenario.layout));
+  assert.equal(result.totalUnits, totalUnits(scenario.inventory));
+  assert.equal(result.skuCount, countSkus(scenario.inventory));
+});
+
+test("projection-04 reflects inventory changes instead of hardcoded totals", () => {
+  const scenario = buildThesisSeed2026();
+  const inventory = ingreso(scenario.inventory, "bin-4-4", "SKU-9999", 7);
+  const changedScenario = { ...scenario, inventory };
+
+  const baseResult = projection04.project(scenario);
+  const changedResult = projection04.project(changedScenario);
+
+  assert.equal(changedResult.totalUnits, baseResult.totalUnits + 7);
+  assert.equal(changedResult.skuCount, baseResult.skuCount + 1);
+});
