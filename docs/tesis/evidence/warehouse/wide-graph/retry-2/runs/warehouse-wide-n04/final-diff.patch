@@ -0,0 +1,37 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ingreso, totalUnits, countSkus } from "../domain/inventory.ts";
+import { countBins, countZones } from "../domain/layout.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection01 } from "./projection-01.ts";
+
+test("projection-01 exposes its fixed projection id", () => {
+  assert.equal(projection01.id, "projection-01");
+});
+
+test("projection-01 derives W1 result fields from the thesis seed scenario", () => {
+  const scenario = buildThesisSeed2026();
+
+  assert.deepEqual(projection01.project(scenario), {
+    projectionId: "projection-01:thesis-seed-2026",
+    id: "projection-01",
+    scenario: scenario.name,
+    metric: "bin-capacity",
+    value: countBins(scenario.layout),
+    zoneCount: countZones(scenario.layout),
+    binCount: countBins(scenario.layout),
+    totalUnits: totalUnits(scenario.inventory),
+    skuCount: countSkus(scenario.inventory),
+  });
+});
+
+test("projection-01 reflects inventory behavior instead of hardcoded totals", () => {
+  const scenario = buildThesisSeed2026();
+  const changedInventory = ingreso(scenario.inventory, "bin-1-1", "SKU-9999", 7);
+
+  const result = projection01.project({ ...scenario, inventory: changedInventory });
+
+  assert.equal(result.totalUnits, totalUnits(scenario.inventory) + 7);
+  assert.equal(result.skuCount, countSkus(scenario.inventory) + 1);
+});
+
