+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { buildThesisSeed2026, THESIS_SEED_2026 } from "../scenarios/thesis-seed-2026.ts";
+import { buildRegistryResults } from "./registry.ts";
+import { buildStudyWideGraphReport, main } from "./study-wide-graph.ts";
+
+test("package manifest exposes study:wide-graph", () => {
+  const manifest = JSON.parse(readFileSync("package.json", "utf8")) as {
+    scripts?: Record<string, string>;
+  };
+
+  assert.equal(manifest.scripts?.["study:wide-graph"], "node src/analytics/study-wide-graph.ts");
+});
+
+test("buildStudyWideGraphReport uses the thesis scenario and ordered registry results", () => {
+  const scenario = buildThesisSeed2026();
+  const report = buildStudyWideGraphReport();
+
+  assert.equal(report.schemaVersion, 1);
+  assert.equal(report.moduleCount, 4);
+  assert.equal(report.scenario, THESIS_SEED_2026);
+  assert.deepEqual(report.projections, buildRegistryResults(scenario));
+  assert.deepEqual(
+    report.projections.map((projection) => projection.id),
+    ["projection-01", "projection-02", "projection-03", "projection-04"],
+  );
+});
+
+test("main emits byte-stable compact JSON", () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.equal(first, JSON.stringify(JSON.parse(first)));
+});
+
+test("study CLI writes exactly one JSON object and no other output", () => {
+  const first = spawnSync(process.argv[0], ["src/analytics/study-wide-graph.ts"], {
+    encoding: "utf8",
+  });
+  const second = spawnSync(process.argv[0], ["src/analytics/study-wide-graph.ts"], {
+    encoding: "utf8",
+  });
+
+  assert.equal(first.status, 0);
+  assert.equal(second.status, 0);
+  assert.equal(first.stderr, "");
+  assert.equal(second.stderr, "");
+  assert.equal(first.stdout, second.stdout);
+  assert.equal(first.stdout.trim(), first.stdout);
+
+  const parsed = JSON.parse(first.stdout) as ReturnType<typeof buildStudyWideGraphReport>;
+  assert.equal(parsed.schemaVersion, 1);
+  assert.equal(parsed.moduleCount, 4);
+  assert.equal(parsed.scenario, THESIS_SEED_2026);
+  assert.equal(parsed.projections.length, 4);
+});
diff --git a/src/analytics/study-wide-graph.ts b/src/analytics/study-wide-graph.ts
new file mode 100644
index 0000000..aa7057a
--- /dev/null
+++ b/src/analytics/study-wide-graph.ts
@@ -0,0 +1,35 @@
+import { pathToFileURL } from "node:url";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { buildRegistryResults } from "./registry.ts";
+import type { WarehouseProjectionResult } from "./contracts.ts";
+
+const SCHEMA_VERSION = 1;
+
+export interface StudyWideGraphReport {
+  readonly schemaVersion: 1;
+  readonly moduleCount: number;
+  readonly scenario: string;
+  readonly projections: readonly WarehouseProjectionResult[];
+}
+
+export function buildStudyWideGraphReport(): StudyWideGraphReport {
+  const scenario = buildThesisSeed2026();
+  const projections = buildRegistryResults(scenario);
+
+  return {
+    schemaVersion: SCHEMA_VERSION,
+    moduleCount: projections.length,
+    scenario: scenario.name,
+    projections,
+  };
+}
+
+export function main(): string {
+  return JSON.stringify(buildStudyWideGraphReport());
+}
+
+const isMainModule = process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href;
+
+if (isMainModule) {
+  process.stdout.write(main());
+}
