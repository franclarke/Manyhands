+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countSkus, ingreso, totalUnits } from "../domain/inventory.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { buildRegistryResults, listWarehouseProjections } from "./registry.ts";
+
+test("registry exposes all projections ordered by id", () => {
+  assert.deepEqual(
+    listWarehouseProjections().map((projection) => projection.id),
+    ["projection-01", "projection-02", "projection-03", "projection-04"],
+  );
+});
+
+test("registry returns one result per projection in id order", () => {
+  const scenario = buildThesisSeed2026();
+
+  const expectedResults = listWarehouseProjections().map((projection) => projection.project(scenario));
+
+  assert.deepEqual(buildRegistryResults(scenario), expectedResults);
+});
+
+test("registry results are derived from the scenario inventory", () => {
+  const scenario = buildThesisSeed2026();
+  const inventory = ingreso(scenario.inventory, "bin-1-1", "SKU-9999", 7);
+
+  const results = buildRegistryResults({ ...scenario, inventory });
+
+  assert.equal(results.length, 4);
+  for (const result of results) {
+    assert.equal(result.totalUnits, totalUnits(inventory));
+    assert.equal(result.skuCount, countSkus(inventory));
+  }
+});
