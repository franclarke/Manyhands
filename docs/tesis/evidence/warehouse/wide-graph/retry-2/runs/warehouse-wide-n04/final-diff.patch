+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countSkus, ingreso, totalUnits } from "../domain/inventory.ts";
+import { countBins, countZones } from "../domain/layout.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection03 } from "./projection-03.ts";
+
+test("projection-03 exposes its projection id", () => {
+  assert.equal(projection03.id, "projection-03");
+});
+
+test("projection-03 derives result fields from the W1 scenario inventory", () => {
+  const scenario = buildThesisSeed2026();
+
+  assert.deepEqual(projection03.project(scenario), {
+    projectionId: projection03.id,
+    id: projection03.id,
+    scenario: scenario.name,
+    metric: "sku-breadth",
+    value: countSkus(scenario.inventory),
+    zoneCount: countZones(scenario.layout),
+    binCount: countBins(scenario.layout),
+    totalUnits: totalUnits(scenario.inventory),
+    skuCount: countSkus(scenario.inventory),
+  });
+});
+
+test("projection-03 recomputes inventory totals from observable scenario behavior", () => {
+  const scenario = buildThesisSeed2026();
+  const baseProjection = projection03.project(scenario);
+  const changedInventory = ingreso(scenario.inventory, "bin-1-1", "SKU-9999", 7);
+  const changedProjection = projection03.project({
+    ...scenario,
+    inventory: changedInventory,
+  });
+
+  assert.equal(changedProjection.totalUnits, totalUnits(changedInventory));
+  assert.equal(changedProjection.skuCount, countSkus(changedInventory));
+  assert.equal(changedProjection.totalUnits, baseProjection.totalUnits + 7);
+  assert.equal(changedProjection.skuCount, baseProjection.skuCount + 1);
+});
