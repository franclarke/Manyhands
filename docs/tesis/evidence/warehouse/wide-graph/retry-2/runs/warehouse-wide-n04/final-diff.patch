+++ b/src/analytics/registry.ts
@@ -0,0 +1,29 @@
+import type { Scenario } from "../scenarios/thesis-seed-2026.ts";
+import type { WarehouseProjection, WarehouseProjectionResult } from "./contracts.ts";
+import { projection01 } from "./projection-01.ts";
+import { projection02 } from "./projection-02.ts";
+import { projection03 } from "./projection-03.ts";
+import { projection04 } from "./projection-04.ts";
+
+const registeredProjections: readonly WarehouseProjection[] = [
+  projection01,
+  projection02,
+  projection03,
+  projection04,
+];
+
+function compareProjectionId(left: WarehouseProjection, right: WarehouseProjection): number {
+  return left.id.localeCompare(right.id);
+}
+
+export const warehouseProjections: readonly WarehouseProjection[] = Object.freeze(
+  [...registeredProjections].sort(compareProjectionId),
+);
+
+export function buildRegistryResults(scenario: Scenario): WarehouseProjectionResult[] {
+  return warehouseProjections.map((projection) => projection.project(scenario));
+}
+
+export function listWarehouseProjections(): readonly WarehouseProjection[] {
+  return warehouseProjections;
+}
