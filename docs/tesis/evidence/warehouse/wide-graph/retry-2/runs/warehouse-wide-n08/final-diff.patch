+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countSkus, ingreso, totalUnits } from "../domain/inventory.ts";
+import { countBins, countZones } from "../domain/layout.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection01 } from "./projection-01.ts";
+
+test("projection-01 derives W1 inventory totals from inventory behavior", () => {
+  const scenario = buildThesisSeed2026();
+
+  assert.deepEqual(projection01.project(scenario), {
+    projectionId: projection01.id,
+    totalUnits: totalUnits(scenario.inventory),
+    skuCount: countSkus(scenario.inventory),
+    zones: countZones(scenario.layout),
+    bins: countBins(scenario.layout),
+  });
+
+  const inventory = ingreso(scenario.inventory, scenario.layout.bins[0].id, "SKU-PROJECTION-ONLY", 7);
+  const adjustedScenario = { ...scenario, inventory };
+
+  assert.deepEqual(projection01.project(adjustedScenario), {
+    projectionId: projection01.id,
+    totalUnits: totalUnits(inventory),
+    skuCount: countSkus(inventory),
+    zones: countZones(adjustedScenario.layout),
+    bins: countBins(adjustedScenario.layout),
+  });
+});
