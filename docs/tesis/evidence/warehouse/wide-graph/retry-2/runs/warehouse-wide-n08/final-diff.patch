+++ b/src/analytics/registry.ts
@@ -0,0 +1,31 @@
+import { type Scenario } from "../scenarios/thesis-seed-2026.ts";
+import { type ProjectionResult, type WarehouseProjection } from "./contracts.ts";
+import { projection01 } from "./projection-01.ts";
+import { projection02 } from "./projection-02.ts";
+import { projection03 } from "./projection-03.ts";
+import { projection04 } from "./projection-04.ts";
+import { projection05 } from "./projection-05.ts";
+import { projection06 } from "./projection-06.ts";
+import { projection07 } from "./projection-07.ts";
+import { projection08 } from "./projection-08.ts";
+
+export type { ProjectionResult };
+
+const REGISTERED_PROJECTIONS: readonly WarehouseProjection<ProjectionResult>[] = [
+  projection01,
+  projection02,
+  projection03,
+  projection04,
+  projection05,
+  projection06,
+  projection07,
+  projection08,
+].sort((left, right) => left.id.localeCompare(right.id));
+
+export function getProjections(): readonly WarehouseProjection<ProjectionResult>[] {
+  return REGISTERED_PROJECTIONS;
+}
+
+export function projectScenario(scenario: Scenario): readonly ProjectionResult[] {
+  return REGISTERED_PROJECTIONS.map((projection) => projection.project(scenario));
+}
