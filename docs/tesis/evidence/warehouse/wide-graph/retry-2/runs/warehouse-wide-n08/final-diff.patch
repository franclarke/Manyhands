+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildWideGraphStudyReport, main } from "./wide-graph-cli.ts";
+
+const PROJECTION_IDS = [
+  "projection-01",
+  "projection-02",
+  "projection-03",
+  "projection-04",
+  "projection-05",
+  "projection-06",
+  "projection-07",
+  "projection-08",
+];
+
+test("buildWideGraphStudyReport emits the required study envelope", () => {
+  const report = buildWideGraphStudyReport();
+
+  assert.deepEqual(Object.keys(report), ["schemaVersion", "moduleCount", "scenario", "projections"]);
+  assert.equal(report.schemaVersion, 1);
+  assert.equal(report.moduleCount, 8);
+  assert.equal(report.scenario, "thesis-seed-2026");
+  assert.equal(report.projections.length, 8);
+  assert.deepEqual(
+    report.projections.map((result) => result.projectionId),
+    PROJECTION_IDS,
+  );
+});
+
+test("main emits byte-identical JSON across repeated invocations", () => {
+  const first = main();
+  const second = main();
+
+  assert.equal(first, second);
+  assert.equal(first.trim(), first);
+  JSON.parse(first);
+});
+
+test("main returns exactly one JSON object", () => {
+  const output = main();
+
+  assert.match(output, /^\{.*\}$/s);
+  assert.equal(output.includes("\n"), false);
+
+  const report = JSON.parse(output);
+  assert.equal(report.schemaVersion, 1);
+  assert.equal(report.moduleCount, 8);
