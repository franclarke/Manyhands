+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countSkus, ingreso, skuIds, totalUnits } from "../domain/inventory.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection05 } from "./projection-05.ts";
+
+test("projection-05 derives totals from W1 inventory behavior", () => {
+  const baseScenario = buildThesisSeed2026();
+  const inventory = ingreso(baseScenario.inventory, "bin-1-1", "SKU-P05-NEW", 7);
+  const scenario = { ...baseScenario, inventory };
+
+  const output = projection05.project(scenario);
+
+  assert.equal(output.projectionId, projection05.id);
+  assert.deepEqual(output, {
+    projectionId: projection05.id,
+    totalUnits: totalUnits(inventory),
+    skuCount: countSkus(inventory),
+    skuIds: skuIds(inventory).sort(),
+  });
+  assert.ok(output.totalUnits !== totalUnits(baseScenario.inventory));
+  assert.ok(output.skuCount !== countSkus(baseScenario.inventory));
+});
