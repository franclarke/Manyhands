+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { countSkus, ingreso, totalUnits } from "../domain/inventory.ts";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { projection04 } from "./projection-04.ts";
+
+test("projection-04 reports W1 inventory totals from inventory behavior", () => {
+  const scenario = buildThesisSeed2026();
+  const baseline = projection04.project(scenario);
+
+  assert.equal(baseline.projectionId, projection04.id);
+  assert.equal(baseline.totalUnits, totalUnits(scenario.inventory));
+  assert.equal(baseline.skuCount, countSkus(scenario.inventory));
+  assert.equal(baseline.emptyBins, scenario.layout.bins.length - scenario.inventory.quantities.size);
+
+  const [firstBin] = scenario.layout.bins;
+  assert.ok(firstBin);
+
+  const adjustedInventory = ingreso(scenario.inventory, firstBin.id, "SKU-P04-NEW", 7);
+  const adjustedScenario = { ...scenario, inventory: adjustedInventory };
+  const adjusted = projection04.project(adjustedScenario);
+
+  assert.equal(adjusted.projectionId, projection04.id);
+  assert.equal(adjusted.totalUnits, totalUnits(adjustedInventory));
+  assert.equal(adjusted.skuCount, countSkus(adjustedInventory));
+  assert.equal(adjusted.emptyBins, adjustedScenario.layout.bins.length - adjustedInventory.quantities.size);
+  assert.equal(adjusted.totalUnits - baseline.totalUnits, 7);
+  assert.equal(adjusted.skuCount - baseline.skuCount, 1);
+});
