+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildThesisSeed2026 } from "../scenarios/thesis-seed-2026.ts";
+import { getProjections, projectScenario } from "./registry.ts";
+
+const PROJECTION_IDS = [
+  "projection-01",
+  "projection-02",
+  "projection-03",
+  "projection-04",
+  "projection-05",
+  "projection-06",
+  "projection-07",
+  "projection-08",
+];
+
+test("registry lists every projection ordered by id", () => {
+  assert.deepEqual(
+    getProjections().map((projection) => projection.id),
+    PROJECTION_IDS,
+  );
+});
+
+test("registry returns thesis-seed-2026 projection results ordered by id", () => {
+  const results = projectScenario(buildThesisSeed2026());
+
+  assert.deepEqual(
+    results.map((result) => result.projectionId),
+    PROJECTION_IDS,
+  );
+});
diff --git a/src/analytics/registry.ts b/src/analytics/registry.ts
