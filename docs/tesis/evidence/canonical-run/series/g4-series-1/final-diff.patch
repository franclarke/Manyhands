+const supportedExpenseCategorySet = new Set<string>(SUPPORTED_EXPENSE_CATEGORIES);
+
+export function isSupportedExpenseCategory(category: string): category is ExpenseCategory {
+  return supportedExpenseCategorySet.has(category);
+}
+
 export function createExpense(input: Expense): Expense {
   if (input.amountCents <= 0) throw new Error("An expense amount must be positive.");
   if (input.sharedWithParticipantIds.length === 0) throw new Error("An expense must be shared with at least one participant.");
+  if (input.category !== undefined && !isSupportedExpenseCategory(input.category)) throw new Error(`Unsupported expense category: ${input.category}.`);
