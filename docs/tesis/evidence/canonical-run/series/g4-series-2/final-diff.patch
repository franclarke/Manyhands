+export const EXPENSE_CATEGORIES = ["food", "transport", "lodging", "utilities", "entertainment", "other"] as const;
+export const UNCATEGORIZED_CATEGORY = "uncategorized";
+
+export type ExpenseCategory = (typeof EXPENSE_CATEGORIES)[number];
+export type CategoryTotalCategory = ExpenseCategory | typeof UNCATEGORIZED_CATEGORY;
+
 export interface Expense {
   id: string;
   description: string;
   amountCents: number;
   paidByParticipantId: string;
   sharedWithParticipantIds: string[];
+  category?: ExpenseCategory;
 }
 
 export interface Balance {
@@ -17,9 +24,24 @@ export interface Balance {
   netCents: number;
 }
 
+export interface CategoryTotal {
+  category: CategoryTotalCategory;
+  totalCents: number;
+}
+
+const CATEGORY_TOTAL_ORDER: readonly CategoryTotalCategory[] = [...EXPENSE_CATEGORIES, UNCATEGORIZED_CATEGORY];
+const allowedCategories = new Set<string>(EXPENSE_CATEGORIES);
+
+function isExpenseCategory(category: string): category is ExpenseCategory {
+  return allowedCategories.has(category);
+}
+
 export function createExpense(input: Expense): Expense {
   if (input.amountCents <= 0) throw new Error("An expense amount must be positive.");
   if (input.sharedWithParticipantIds.length === 0) throw new Error("An expense must be shared with at least one participant.");
+  if (input.category !== undefined && !isExpenseCategory(input.category)) {
+    throw new Error(`Invalid expense category: ${input.category}.`);
+  }
   return { ...input, sharedWithParticipantIds: [...new Set(input.sharedWithParticipantIds)] };
 }
 
@@ -35,3 +57,17 @@ export function computeBalances(participants: readonly Participant[], expenses:
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+export function computeCategoryTotals(expenses: readonly Expense[]): CategoryTotal[] {
+  const totals = new Map<CategoryTotalCategory, number>();
+
+  for (const expense of expenses) {
+    const category = expense.category ?? UNCATEGORIZED_CATEGORY;
+    totals.set(category, (totals.get(category) ?? 0) + expense.amountCents);
+  }
+
+  return CATEGORY_TOTAL_ORDER.flatMap((category) => {
+    const totalCents = totals.get(category) ?? 0;
+    return totalCents > 0 ? [{ category, totalCents }] : [];
+  });
+}
