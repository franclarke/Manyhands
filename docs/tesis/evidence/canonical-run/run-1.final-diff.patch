+
+export function computeCategoryTotals(expenses: readonly Expense[]): CategoryTotals {
+  const totals: CategoryTotals = {};
+  for (const expense of expenses) {
+    const category = expense.category ?? "uncategorized";
+    totals[category] = (totals[category] ?? 0) + expense.amountCents;
+  }
+  return totals;
+}
