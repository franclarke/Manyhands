 function formatCents(cents: number): string {
   return `${cents < 0 ? "-" : ""}$${(Math.abs(cents) / 100).toFixed(2)}`;
@@ -16,3 +16,13 @@ export function renderBalanceSummary(participants: readonly Participant[], balan
   });
   return lines.join("\n");
 }
+
+export function renderCategoryBreakdown(totals: CategoryTotals): string {
+  return Object.entries(totals)
+    .sort(([leftCategory, leftCents], [rightCategory, rightCents]) => {
+      if (rightCents !== leftCents) return rightCents - leftCents;
+      return leftCategory.localeCompare(rightCategory);
+    })
+    .map(([category, cents]) => `${category}: ${formatCents(cents)}`)
+    .join("\n");
+}
