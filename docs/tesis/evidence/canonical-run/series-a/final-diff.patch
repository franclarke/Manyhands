@@ -3,12 +3,17 @@ export interface Participant {
   name: string;
 }
 
+export const EXPENSE_CATEGORIES = ["food", "transport", "housing", "utilities", "entertainment", "other"] as const;
+
+export type ExpenseCategory = (typeof EXPENSE_CATEGORIES)[number];
+
 export interface Expense {
   id: string;
   description: string;
   amountCents: number;
   paidByParticipantId: string;
   sharedWithParticipantIds: string[];
+  category?: ExpenseCategory;
 }
 
 export interface Balance {
@@ -17,9 +22,21 @@ export interface Balance {
   netCents: number;
 }
 
+export interface CategoryTotal {
+  category: ExpenseCategory;
+  totalCents: number;
+}
+
+function assertExpenseCategory(category: unknown): asserts category is ExpenseCategory {
+  if (typeof category !== "string" || !EXPENSE_CATEGORIES.includes(category as ExpenseCategory)) {
+    throw new Error(`Unknown expense category: ${String(category)}.`);
+  }
+}
+
 export function createExpense(input: Expense): Expense {
   if (input.amountCents <= 0) throw new Error("An expense amount must be positive.");
   if (input.sharedWithParticipantIds.length === 0) throw new Error("An expense must be shared with at least one participant.");
+  if (input.category !== undefined) assertExpenseCategory(input.category);
   return { ...input, sharedWithParticipantIds: [...new Set(input.sharedWithParticipantIds)] };
 }
 
@@ -35,3 +52,17 @@ export function computeBalances(participants: readonly Participant[], expenses:
   }
   return [...net.entries()].map(([participantId, netCents]) => ({ participantId, netCents }));
 }
+
+export function computeCategoryTotals(expenses: readonly Expense[]): CategoryTotal[] {
+  const totals = new Map<ExpenseCategory, number>();
+  for (const expense of expenses) {
+    if (expense.category === undefined) continue;
+    assertExpenseCategory(expense.category);
+    totals.set(expense.category, (totals.get(expense.category) ?? 0) + expense.amountCents);
+  }
+
+  return EXPENSE_CATEGORIES.flatMap((category) => {
+    const totalCents = totals.get(category);
+    return totalCents === undefined ? [] : [{ category, totalCents }];
+  });
+}
