+++ b/test/warehouse-api.test.mjs
@@ -0,0 +1,44 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createWarehouseApi } from "../src/api/warehouse-api.mjs";
+import { createOrderService } from "../src/application/order-service.mjs";
+import { createWarehouse } from "../src/domain/orders.mjs";
+
+test("exposes currentOrders, currentBackorders, and events for a reserved order", () => {
+  const api = createWarehouseApi(createOrderService(createWarehouse({ sku: 3 })));
+
+  api.placeOrder({ orderId: "o-1", skuId: "sku", quantity: 2 });
+
+  assert.deepEqual(api.currentOrders(), [
+    {
+      orderId: "o-1",
+      skuId: "sku",
+      quantity: 2,
+      priority: "standard",
+      status: "reserved"
+    }
+  ]);
+  assert.deepEqual(api.currentBackorders(), []);
+  assert.deepEqual(api.events(), [{ type: "order-reserved", orderId: "o-1" }]);
+});
+
+test("exposes exact backorder shape through currentBackorders and events", () => {
+  const api = createWarehouseApi(createOrderService(createWarehouse({ sku: 1 })));
+
+  api.placeOrder({ orderId: "o-2", skuId: "sku", quantity: 3, priority: "express" });
+
+  assert.deepEqual(api.currentOrders(), [
+    {
+      orderId: "o-2",
+      skuId: "sku",
+      quantity: 3,
+      priority: "express",
+      status: "backordered"
+    }
+  ]);
+  assert.deepEqual(api.currentBackorders(), [{ orderId: "o-2", skuId: "sku", missing: 2 }]);
+  assert.deepEqual(api.events(), [
+    { type: "order-reserved", orderId: "o-2" },
+    { type: "backorder-recorded", orderId: "o-2", skuId: "sku", missing: 2 }
+  ]);
+});
