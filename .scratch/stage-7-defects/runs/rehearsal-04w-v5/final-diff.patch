diff --git a/test/domain-orders.test.mjs b/test/domain-orders.test.mjs
new file mode 100644
index 0000000..fbe9530
--- /dev/null
+++ b/test/domain-orders.test.mjs
@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { cancelOrder, createWarehouse, placeOrder } from "../src/domain/orders.mjs";
+
+test("reserves available inventory with default standard priority", () => {
+  const next = placeOrder(createWarehouse({ sku: 3 }), { orderId: "o-1", skuId: "sku", quantity: 2 });
+  assert.equal(next.stockBySku.sku, 1);
+  assert.equal(next.orders.length, 1);
+  assert.equal(next.orders[0].orderId, "o-1");
+  assert.equal(next.orders[0].skuId, "sku");
+  assert.equal(next.orders[0].quantity, 2);
+  assert.equal(next.orders[0].priority, "standard");
+  assert.equal(next.orders[0].status, "reserved");
+});
+
+test("accepts express priority", () => {
+  const next = placeOrder(createWarehouse({ sku: 2 }), { orderId: "o-2", skuId: "sku", quantity: 1, priority: "express" });
+  assert.equal(next.orders[0].priority, "express");
+});
+
+test("rejects invalid priority values", () => {
+  assert.throws(
+    () => placeOrder(createWarehouse({ sku: 1 }), { orderId: "o-3", skuId: "sku", quantity: 1, priority: "rush" }),
+    /priority/
+  );
+});
+
+test("records a positive backorder and keeps the order cancellable", () => {
+  const next = placeOrder(createWarehouse({ sku: 1 }), { orderId: "o-4", skuId: "sku", quantity: 3, priority: "express" });
+  assert.equal(next.stockBySku.sku, 1);
+  assert.equal(next.orders.length, 1);
+  assert.equal(next.orders[0].status, "backordered");
+  assert.deepEqual(next.backorders, [{ orderId: "o-4", skuId: "sku", missing: 2 }]);
+
+  const cancelled = cancelOrder(next, "o-4");
+  assert.equal(cancelled.orders[0].status, "cancelled");
+  assert.equal(cancelled.stockBySku.sku, 1);
+  assert.deepEqual(cancelled.backorders, [{ orderId: "o-4", skuId: "sku", missing: 2 }]);
+});
diff --git a/test/order-service.test.mjs b/test/order-service.test.mjs
new file mode 100644
index 0000000..83463a1
--- /dev/null
+++ b/test/order-service.test.mjs
@@ -0,0 +1,27 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createOrderService } from "../src/application/order-service.mjs";
+import { createWarehouse } from "../src/domain/orders.mjs";
+
+test("emits the reserved event for an order that fits available stock", () => {
+  const service = createOrderService(createWarehouse({ sku: 3 }));
+
+  const next = service.place({ orderId: "o-1", skuId: "sku", quantity: 2 });
+
+  assert.equal(next.stockBySku.sku, 1);
+  assert.deepEqual(service.events(), [{ type: "order-reserved", orderId: "o-1" }]);
+  assert.deepEqual(service.currentBackorders(), []);
+});
+
+test("emits exactly one backorder-recorded event when the domain backorders the order", () => {
+  const service = createOrderService(createWarehouse({ sku: 1 }));
+
+  const next = service.place({ orderId: "o-2", skuId: "sku", quantity: 3 });
+
+  assert.equal(next.stockBySku.sku, 1);
+  assert.deepEqual(service.currentBackorders(), [{ orderId: "o-2", skuId: "sku", missing: 2 }]);
+  assert.deepEqual(service.events(), [
+    { type: "order-reserved", orderId: "o-2" },
+    { type: "backorder-recorded", orderId: "o-2", skuId: "sku", missing: 2 }
+  ]);
+});
