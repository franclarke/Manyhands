index 0000000..ba9e4b9
--- /dev/null
+++ b/test/order-service.test.mjs
@@ -0,0 +1,28 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createOrderService } from "../src/application/order-service.mjs";
+import { createWarehouse } from "../src/domain/orders.mjs";
+
+test("preserves the non-backorder path", () => {
+  const service = createOrderService(createWarehouse({ sku: 3 }));
+
+  const state = service.place({ orderId: "o-1", skuId: "sku", quantity: 2 });
+
+  assert.equal(state.stockBySku.sku, 1);
+  assert.equal(state.orders.length, 1);
+  assert.equal(state.orders[0].status, "reserved");
+  assert.deepEqual(service.currentBackorders(), []);
+  assert.deepEqual(service.events(), [{ type: "order-reserved", orderId: "o-1" }]);
+});
+
+test("emits exactly one backorder-recorded event per backorder", () => {
+  const service = createOrderService(createWarehouse({ sku: 1 }));
+
+  const state = service.place({ orderId: "o-1", skuId: "sku", quantity: 3, priority: "express" });
+
+  assert.equal(state.orders.length, 1);
+  assert.equal(state.orders[0].status, "backordered");
+  assert.deepEqual(state.backorders, [{ orderId: "o-1", skuId: "sku", missing: 2 }]);
+  assert.deepEqual(service.currentBackorders(), [{ orderId: "o-1", skuId: "sku", missing: 2 }]);
+  assert.deepEqual(service.events(), [{ type: "backorder-recorded", orderId: "o-1", skuId: "sku", missing: 2 }]);
+});
