diff --git a/test/domain-orders.test.mjs b/test/domain-orders.test.mjs
new file mode 100644
index 0000000..328e01d
--- /dev/null
+++ b/test/domain-orders.test.mjs
@@ -0,0 +1,42 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { cancelOrder, createWarehouse, placeOrder } from "../src/domain/orders.mjs";
+
+test("defaults priority to standard and reserves available inventory", () => {
+  const next = placeOrder(createWarehouse({ sku: 3 }), { orderId: "o-1", skuId: "sku", quantity: 2 });
+  assert.equal(next.stockBySku.sku, 1);
+  assert.equal(next.orders.length, 1);
+  assert.equal(next.orders[0].orderId, "o-1");
+  assert.equal(next.orders[0].skuId, "sku");
+  assert.equal(next.orders[0].quantity, 2);
+  assert.equal(next.orders[0].priority, "standard");
+  assert.equal(next.orders[0].status, "reserved");
+  assert.deepEqual(next.backorders, []);
+});
+
+test("rejects invalid priority values", () => {
+  assert.throws(
+    () => placeOrder(createWarehouse({ sku: 3 }), { orderId: "o-1", skuId: "sku", quantity: 2, priority: "rush" }),
+    /priority/
+  );
+});
+
+test("records a positive backorder and leaves the order cancellable", () => {
+  const placed = placeOrder(createWarehouse({ sku: 1 }), {
+    orderId: "o-1",
+    skuId: "sku",
+    quantity: 3,
+    priority: "express"
+  });
+
+  assert.equal(placed.stockBySku.sku, 1);
+  assert.equal(placed.orders.length, 1);
+  assert.equal(placed.orders[0].status, "backordered");
+  assert.equal(placed.orders[0].priority, "express");
+  assert.deepEqual(placed.backorders, [{ orderId: "o-1", skuId: "sku", missing: 2 }]);
+
+  const cancelled = cancelOrder(placed, "o-1");
+  assert.equal(cancelled.orders[0].status, "cancelled");
+  assert.equal(cancelled.stockBySku.sku, 1);
+  assert.deepEqual(cancelled.backorders, [{ orderId: "o-1", skuId: "sku", missing: 2 }]);
+});
diff --git a/test/order-service.test.mjs b/test/order-service.test.mjs
