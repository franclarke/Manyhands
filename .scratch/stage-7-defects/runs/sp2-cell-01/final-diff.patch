+++ b/test/warehouse-api.test.mjs
@@ -0,0 +1,29 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createWarehouseApi } from "../src/api/warehouse-api.mjs";
+
+test("exposes currentOrders, currentBackorders, and events", () => {
+  const service = {
+    place() {
+      throw new Error("not used");
+    },
+    current() {
+      return {
+        orders: [{ orderId: "o-1", skuId: "sku", quantity: 3, status: "backordered" }],
+        backorders: [{ orderId: "o-1", skuId: "sku", missing: 2 }]
+      };
+    },
+    currentBackorders() {
+      return [{ orderId: "o-1", skuId: "sku", missing: 2 }];
+    },
+    events() {
+      return [{ type: "backorder-recorded", orderId: "o-1", skuId: "sku", missing: 2 }];
+    }
+  };
+
+  const api = createWarehouseApi(service);
+
+  assert.deepEqual(api.currentOrders(), [{ orderId: "o-1", skuId: "sku", quantity: 3, status: "backordered" }]);
+  assert.deepEqual(api.currentBackorders(), [{ orderId: "o-1", skuId: "sku", missing: 2 }]);
+  assert.deepEqual(api.events(), [{ type: "backorder-recorded", orderId: "o-1", skuId: "sku", missing: 2 }]);
+});
